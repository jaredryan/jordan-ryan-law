# Public site origin, used for canonical URLs, sitemap generation, and JSON-LD.
# Read only at build time (Astro frontmatter) — never shipped to the client bundle.
SITE_URL=https://ryanlegalpc.com

# Server-only. Used by netlify/functions/contact.ts to send the consultation-request
# email via Resend (https://resend.com). Sending-only scope; restrict to the verified
# ryanlegalpc.com domain when creating the key.
RESEND_API_KEY=

# Required. Recipient address for the contact-form consultation-request email.
# No fallback exists — if unset, the contact form fails closed with a generic
# "temporarily unavailable" response rather than silently emailing a guessed address.
# Intended value: info@ryanlegalpc.com
CONTACT_TO_EMAIL=

# Required. Sender address for the consultation-request email — must be on a domain
# verified in Resend. No fallback exists; missing this fails closed the same as above.
# Intended value: info@ryanlegalpc.com
CONTACT_FROM_EMAIL=
