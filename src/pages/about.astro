---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SectionNav from '@/components/SectionNav.astro'
import { jordanRyan } from '@/data/people'
import { education, barAdmissions, certifications, experience } from '@/data/credentials'
import { webPageJsonLd, jordanRyanPersonJsonLd, jordanRyanId } from '@/lib/json-ld'
import { businessName } from '@/data/site'

const description = `Learn more about ${jordanRyan.name}, including his education, credentials, experience, and areas of practice.`
const keywords = [
  'Jordan Ryan Attorney',
  'Commercial Real Estate Lawyer',
  'Real Estate Finance Attorney',
  'Entity Formation Lawyer',
  'Texas Real Estate Law',
]

const jsonLd = [
  jordanRyanPersonJsonLd(),
  webPageJsonLd({
    path: '/about',
    name: `About ${businessName}`,
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'About', path: '/about' },
    ],
    pageType: 'AboutPage',
    mainEntity: [{ '@id': jordanRyanId }],
  }),
]

const railSections = [
  { id: 'intro', name: jordanRyan.name },
  { id: 'experience', name: 'Experience' },
  { id: 'education', name: 'Education' },
  { id: 'admissions', name: 'Bar Admissions & Certifications' },
]
---

<BaseLayout title="About" description={description} path="/about" keywords={keywords} jsonLd={jsonLd} flushFooter>
  <div class="about-layout">
    <SectionNav items={railSections} railLabel="On this page" jumpLabel="On this page" density="compact" />

    <div class="about-main">
      <section class="about-section" id="intro">
        <div class="about-narrow">
          <img src="/square-profile-440.webp" alt={jordanRyan.name} width="180" height="180" class="about-portrait" />
          <span class="eyebrow">{jordanRyan.jobTitle}</span>
          <h1>{jordanRyan.name}</h1>
          {jordanRyan.summary.map((paragraph) => <p>{paragraph}</p>)}
          <a href="/contact" class="link-editorial">
            Talk with Jordan <span class="link-editorial__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section class="about-section" id="experience">
        <span class="section-rule" aria-hidden="true"></span>
        <h2>Experience</h2>
        <ul class="about-experience-list about-narrow">
          {experience.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="about-section" id="education">
        <span class="section-rule" aria-hidden="true"></span>
        <h2>Education</h2>
        <ul class="archival-table about-narrow">
          {
            education.map((item) => (
              <li class="archival-table__row">
                <span class="archival-table__label">
                  {item.degree} — {item.institution}
                </span>
                {item.year && <span class="archival-table__meta">{item.year}</span>}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="about-section" id="admissions">
        <span class="section-rule" aria-hidden="true"></span>
        <h2>Bar Admissions &amp; Certifications</h2>
        <ul class="archival-table about-narrow">
          {
            barAdmissions.map((item) => (
              <li class="archival-table__row">
                <span class="archival-table__label">{item.state}</span>
                <span class="archival-table__meta">{item.year}</span>
              </li>
            ))
          }
          {
            certifications.map((item) => (
              <li class="archival-table__row">
                <span class="archival-table__label">{item.label}</span>
                <span class="archival-table__meta">{item.year}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <section class="closing-band">
    <div class="closing-band__inner">
      <span class="closing-band__rule" aria-hidden="true"></span>
      <h2>Practical judgment. Proven experience.</h2>
      <p class="lead">From day-to-day advising to closing the deal, Jordan brings both to every stage.</p>
      <a href="/contact" class="btn btn-primary">Talk with Jordan</a>
    </div>
  </section>
</BaseLayout>

<script src="@/scripts/scroll-spy.ts"></script>

<style>
  .about-layout {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
  }

  .about-main {
    min-width: 0;
  }

  .about-section {
    padding: var(--s8) var(--s5);
    border-top: 1px solid var(--rule);
  }

  .about-section:first-child {
    border-top: none;
  }

  .about-section p {
    max-width: var(--content-narrow);
  }

  /* Reusable prose-measure utility — see about-narrow's original rationale
     (still applies): keeps long-form/short single-column content to a
     comfortable reading width while left edges still align with the
     section heading above them. */
  .about-narrow {
    max-width: var(--content-narrow);
  }

  .about-portrait {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 4px;
    border: 2px solid var(--gold);
    margin-bottom: var(--s5);
  }

  /* Plain bulleted list for Experience's accomplishment statements — same
     gold-dash marker convention used elsewhere for genuine bullet lists
     (the base reset removes native list markers sitewide). */
  .about-experience-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s4);
  }

  .about-experience-list li {
    position: relative;
    padding-left: 1.25em;
    color: var(--fg);
  }

  .about-experience-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 8px;
    height: 2px;
    background: var(--gold-ink);
  }

  @media (max-width: 1099px) {
    .about-narrow {
      margin-left: auto;
      margin-right: auto;
    }

    #intro {
      text-align: center;
    }

    #intro .about-portrait {
      margin-left: auto;
      margin-right: auto;
    }

    #intro p {
      text-align: left;
    }

    .about-section > .section-rule {
      margin-left: auto;
      margin-right: auto;
    }

    .about-section > h2 {
      text-align: center;
    }
  }

  @media (min-width: 1100px) {
    .about-layout {
      grid-template-columns: 200px 1fr;
      gap: var(--s7);
    }

    .about-section {
      padding-left: var(--s6);
    }
  }
</style>
