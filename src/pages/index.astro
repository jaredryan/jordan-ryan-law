---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { businessName, businessSlogan, businessMission, defaultDescription, defaultKeywords } from '@/data/site'
import { areasOfPractice } from '@/data/practice-areas'
import { jordanRyan } from '@/data/people'
import { legalServiceJsonLd, websiteJsonLd, webPageJsonLd, jordanRyanId } from '@/lib/json-ld'

// One consistent line-icon family for the practice-area grid — restrained,
// business/structural shapes (no gavels/scales/columns). Keyed by slug
// rather than baked into practice-areas.ts since these are a homepage
// presentation detail, not core practice-area data.
const practiceIcons: Record<string, string> = {
  'acquisition-and-disposition': `<line x1="3" y1="8" x2="17" y2="8"/><polyline points="13,4 17,8 13,12"/><line x1="21" y1="16" x2="7" y2="16"/><polyline points="11,20 7,16 11,12"/>`,
  leasing: `<circle cx="8" cy="9" r="3.25"/><line x1="10.3" y1="11.3" x2="19" y2="20"/><line x1="15" y1="16" x2="17" y2="14"/><line x1="17.5" y1="18.5" x2="19.5" y2="16.5"/>`,
  'real-estate-finance': `<line x1="4" y1="20" x2="20" y2="20"/><rect x="5.5" y="13" width="3.5" height="7"/><rect x="10.5" y="8" width="3.5" height="12"/><rect x="15.5" y="4" width="3.5" height="16"/>`,
  'due-diligence': `<rect x="4" y="3" width="12" height="16" rx="1"/><line x1="7" y1="7" x2="13" y2="7"/><line x1="7" y1="10.5" x2="13" y2="10.5"/><circle cx="16.5" cy="15.5" r="3"/><line x1="18.8" y1="17.8" x2="21.5" y2="20.5"/>`,
  'entity-formation-and-joint-ventures': `<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><line x1="7.7" y1="7.3" x2="10.5" y2="16.2"/><line x1="16.3" y1="7.3" x2="13.5" y2="16.2"/><line x1="8" y1="6" x2="16" y2="6"/>`,
  development: `<path d="M4 21V11l5-3v13"/><path d="M9 21V8l6-3v16"/><path d="M15 21V13l5-2v10"/><line x1="3" y1="21" x2="21" y2="21"/>`,
}

const jsonLd = [
  legalServiceJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/',
    name: `${businessName} - Commercial Real Estate Law Firm`,
    description: defaultDescription,
    // Single-entry breadcrumb (Home alone) is intentionally omitted by webPageJsonLd.
    breadcrumbs: [{ name: 'Home', path: '/' }],
    mentions: [{ '@id': jordanRyanId }],
  }),
]

const proofItems = [
  {
    value: '13+ Years',
    label: 'Commercial Real Estate Experience',
  },
  {
    value: 'Board Certified',
    label: 'Commercial Real Estate Law — Texas',
  },
  {
    value: '1,000+ Acres',
    label: 'Acquisition & Entitlement',
  },
  {
    value: '5M+ Sq. Ft.',
    label: 'Industrial & office leases negotiated',
  },
] as const
---

<BaseLayout
  title={businessName}
  description={defaultDescription}
  path="/"
  keywords={defaultKeywords}
  jsonLd={jsonLd}
  flushFooter
>
  <section class="hero page-section">
    <div class="hero__grid">
      <div class="hero__copy">
        <span class="eyebrow eyebrow--standalone">Dallas - Fort Worth, TX</span>
        <h1>Commercial Real Estate Counsel. Business-Minded Advice.</h1>
        <p class="lead">{businessSlogan}</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn-primary">Schedule a Consultation</a>
          <a href="/about/" class="link-editorial hero__secondary-cta">
            Learn about the firm <span class="link-editorial__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <figure class="hero__portrait">
        <div class="hero__portrait-frame">
          <span class="hero__portrait-bracket hero__portrait-bracket--tl" aria-hidden="true"></span>
          <span class="hero__portrait-bracket hero__portrait-bracket--br" aria-hidden="true"></span>
          <img
            src="/square-profile-640.webp"
            srcset="/square-profile-440.webp 440w, /square-profile-640.webp 640w, /square-profile.webp 833w"
            sizes="(max-width: 720px) 208px, 280px"
            alt={jordanRyan.name}
            width="360"
            height="360"
          />
        </div>
        <figcaption class="hero__portrait-caption">
          <span class="hero__portrait-name">{jordanRyan.name}</span>
          <span class="hero__portrait-title">{jordanRyan.jobTitle}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="proof-band" aria-label="Credentials and experience">
    <ul class="proof-strip proof-band__inner">
      {
        proofItems.map((item) => (
          <li class="proof-figure">
            <span class="proof-figure__value">{item.value}</span>
            <span class="proof-figure__label">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section practice-overview">
    <div class="section-intro">
      <div class="section-intro__frame bracket-frame bracket-frame--lg">
        <span class="eyebrow">What we handle</span>
        <h2>Practice Areas</h2>
      </div>
    </div>
    <ul class="practice-grid">
      {
        areasOfPractice.map((area) => (
          <li class="practice-grid__item">
            <svg
              class="practice-grid__icon"
              viewBox="0 0 24 24"
              width="48"
              height="48"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={practiceIcons[area.slug]}
            />
            <h3>{area.name}</h3>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section values-mission">
    <div class="section-intro">
      <div class="section-intro__frame bracket-frame bracket-frame--lg">
        <span class="eyebrow">What we do</span>
        <h2>Our Mission</h2>
      </div>
    </div>
    <div class="values-mission__columns">
      {businessMission.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="closing-band">
    <div class="closing-band__inner">
      <div class="closing-band__heading-frame" data-cta-bracket>
        <h2 class="closing-band__heading">Move your next transaction forward with confidence.</h2>
        <span class="cta-bracket cta-bracket--tl" data-cta-bracket-tl aria-hidden="true"></span>
        <span class="cta-bracket cta-bracket--br" data-cta-bracket-br aria-hidden="true"></span>
      </div>
      <p class="lead">Practical, business-minded counsel for commercial real estate and business matters.</p>
      <a href="/contact/" class="btn btn-primary">Request a consultation</a>
    </div>
  </section>
</BaseLayout>

<script src="@/scripts/cta-bracket.ts"></script>

<style>
  /* Text-dominant editorial hero: the copy column carries the composition,
     the portrait is a small, deliberately secondary inset — never the
     giant focal image a "hero photo" implies. A thin structural rule opens
     the section, echoing the logo's architectural, drafted-line quality;
     the same language returns, once, as the portrait's corner bracket
     below — the page's one signature motif, spent in exactly two places. */
  .hero {
    padding-top: var(--s8);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 280px);
    gap: var(--s8);
    align-items: start;
  }

  .hero__copy h1 {
    max-width: 19ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s6);
    flex-wrap: wrap;
    margin-top: var(--s6);
  }

  .hero__secondary-cta {
    white-space: nowrap;
  }

  /* Portrait: framed and off to the side rather than centered and full-bleed
     — a dossier inset the copy column still visually outweighs, keeping the
     hero text-led even with a strong source photo. The grayscale/contrast
     lift unifies its tone with the rest of the page instead of sitting as a
     separate, higher-saturation photo block. */
  .hero__portrait {
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 280px;
  }

  /* Owns the relative positioning context for the corner brackets, so they
     frame the photograph alone — the caption below sits outside the frame,
     in the figure's normal flow rather than inside this positioned box. */
  .hero__portrait-frame {
    position: relative;
  }

  .hero__portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--border);
    filter: grayscale(15%) contrast(1.05) saturate(0.9);
  }

  /* The site's canonical bracket reference: a top-left + bottom-right
     corner pair loosely framing the portrait. Every other bracket use on
     the site (see .bracket-frame in global.css) is this same geometry
     applied at a smaller scale to text/heading content. */
  .hero__portrait-bracket {
    position: absolute;
    width: 26px;
    height: 26px;
    pointer-events: none;
  }

  .hero__portrait-bracket--tl {
    top: -12px;
    left: -12px;
    border-top: 2px solid var(--stone);
    border-left: 2px solid var(--stone);
  }

  .hero__portrait-bracket--br {
    bottom: -12px;
    right: -12px;
    border-bottom: 2px solid var(--stone);
    border-right: 2px solid var(--stone);
  }

  .hero__portrait-caption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--s3);
    text-align: left;
  }

  .hero__portrait-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .hero__portrait-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--stone-ink);
  }

  /* A shallow, full-bleed tinted band — the first clearly perceptible
     boundary in the page, distinguishing verified figures from the
     surrounding editorial copy without introducing a new page color. */
  .proof-band {
    width: 100%;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .proof-band__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s6) var(--s5);
    /* Four items divide evenly into either 2 or 4 columns, so there's no
       orphan risk at any width the way there was with five — no last-item
       span-fix needed. 4-up by default (four short items fit comfortably
       in a row down to fairly narrow widths); 2-up only once that row
       actually gets tight, reusing the existing .page-section mobile
       breakpoint rather than a one-off value. */
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s6) var(--s5);
    /* Top-align every item's own content instead of stretching it to match
       the tallest neighbor — labels wrap to different line counts (e.g.
       "Commercial Real Estate Law — Texas" vs. "Acquisition & Entitlement"),
       and stretch would center the shorter ones, reading as misaligned
       rather than intentional. */
    align-items: start;
  }

  @media (max-width: 940px) {
    .proof-band__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 350px) {
    .proof-band__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Vertical structural rail — replaces the old bracket frame around the
     whole strip. Each item gets its own full-height accent rail along its
     left edge (the border naturally spans the li's full content height,
     headline + supporting label) rather than one frame around the group,
     so the proof strip's motif is distinct from the corner-bracket system
     used for identity/section-heading framing. All four items share the
     base primitive's large numeral/label treatment (.proof-figure__value /
     __label in global.css) untouched — there's no separate credential
     variant anymore, so nothing here overrides that typography. */
  .proof-figure {
    border-left: 2px solid var(--stone);
    padding-left: var(--s4);
  }

  /* A deliberate compositional restart after the proof band: centered
     eyebrow/heading (breaking from the hero's left alignment) under a short
     stone rule, rather than just resuming the same left-aligned flow. Shared
     verbatim by Practice Areas and Vision & Mission below — both are the
     same "compositional restart" device, not two coincidentally-identical
     ones, so they share one class rather than two page-local copies. */
  .section-intro {
    text-align: center;
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding-top: var(--s2);
  }

  .section-intro .eyebrow {
    margin-bottom: var(--s2);
  }

  .section-intro h2 {
    margin-bottom: 0;
  }

  /* Frames the eyebrow + heading as one compact section-identity block —
     distinct from the plain standalone eyebrows (hero, About, Contact),
     which carry no bracket: here the corners wrap the whole two-line
     group, sized to hug it rather than the eyebrow alone. */
  .section-intro__frame {
    width: fit-content;
    margin: 0 auto;
  }

  /* One unified architectural grid on the emphasized surface, rather than
     six floating cards: fine 1px seams between cells (grid gap filled with
     a translucent divider line, each cell's own --surface-emphasis
     background painted over it) instead of per-card borders/shadows — the
     grid itself provides the structure. The matrix uses --surface-emphasis
     regardless of site theme (dark brand-navy in light theme, lifted
     blue-slate in dark theme) so it clearly interrupts the page rhythm in
     both without reaching the closing band's full "destination" weight.
     Static, not interactive: no per-area detail page exists yet to link to
     (see src/data/practice-areas.ts), so cells carry no hover/focus
     affordance. Mobile-first: 1 column now, 2 at tablet, 3 at desktop
     (below). */
  .practice-grid {
    list-style: none;
    margin: var(--s8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    background: var(--stone);
    border: 2px solid var(--stone);
    width: fit-content;
    justify-self: center;
  }

  .practice-grid__item {
    background: var(--surface-emphasis);
    padding: var(--s6) var(--s5);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s4);
    text-align: center;
    max-width: 400px;
  }

  /* Sized up (from the old 28px small-bullet treatment) to function as real
     visual anchors against the emphasized surface. One consistent
     thin-line stroke family, colored with a stone-derived tone rather than
     the interactive accent, so they read as structure, not as links. */
  .practice-grid__icon {
    color: var(--stone);
  }

  .practice-grid__item h3 {
    margin: 0;
    color: var(--nav-footer-text);
  }

  @media (min-width: 581px) {
    .practice-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 901px) {
    .practice-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Deliberately plain, not a raised band: Practice Areas and Mission are
     meant to read as one connected chapter — "what we do" and "why we do
     it" — sharing the same page background rather than being split into
     separate visual movements. No separator rule between them: the
     emphasized Practice Areas matrix above already provides enough visual
     separation on its own — and this section's own top padding is zeroed
     so that separation isn't doubled up with Practice Areas' bottom
     padding on the same page background. Reuses the same .section-intro
     "compositional restart" treatment as Practice Areas above it. The
     paragraph stays left-aligned since centered multi-line body text is
     hard to read. */
  .values-mission {
    padding-top: 0;
  }

  .values-mission__columns {
    max-width: var(--content-narrow);
    margin: var(--s7) auto 0;
    text-align: left;
  }

  .values-mission__columns p {
    margin: 0;
  }

  /* Shared tablet/desktop content boundary: the hero, proof-strip, and
     Practice Areas grid read too close to the viewport edge at wide
     desktop sizes if left at the page's base 1180px content column, so
     they get a tighter shared cap (~1280px) with a larger guaranteed
     gutter instead — aligned to the same outer axis across all three.
     Active from the same point the hero goes two-column (720px) up.
     Mission and the closing CTA are untouched; they already control
     their own width and are meant to read differently. */
  @media (min-width: 721px) {
    .hero,
    .practice-overview {
      max-width: none;
    }

    .hero__grid,
    .proof-band__inner,
    .practice-grid {
      max-width: min(calc(100% - 6rem), 80rem);
      margin-inline: auto;
    }
  }

  /* The shared boundary above reads well at ~1600px+ and again around
     ~1270px and below, but in the intermediate band the hero specifically
     over-stretches and pushes the portrait too close to the right edge —
     so the hero alone gets pulled in further, just in this awkward
     middle-desktop range. Declared after the shared block above so this
     narrower max-width wins in the 1280–1499px overlap. */
  @media (min-width: 1280px) and (max-width: 1499px) {
    .hero__grid {
      max-width: 74rem;
      margin-inline: auto;
    }
  }

  /* Just above the tablet stack (721px+), the portrait column is still at
     its full 280px cap while the copy column has the least room of any
     two-column width — trim the portrait modestly here so it stops
     crowding the copy right at the point the layout goes two-column. */
  @media (min-width: 881px) and (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(160px, 220px);
    }

    .hero__portrait {
      max-width: 220px;
    }
  }

  /* Closer still to the tablet stack, the copy column is tighter again —
     one more modest step down keeps the portrait from crowding it before
     the layout drops to one column at 720px. */
  @media (min-width: 721px) and (max-width: 880px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(150px, 190px);
    }

    .hero__portrait {
      max-width: 190px;
    }
  }

  /* Tablet: columns narrow enough that the 220px portrait column starts
     crowding the copy — drop to one column and let the portrait become a
     small centered card below the copy, still clearly secondary. */
  @media (max-width: 720px) {
    .hero {
      padding-top: var(--s6);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      /* Stacked layout only: the two-column gap (--s8, 64px) plus the
         portrait's own margin-top below compounded to ~112px between the
         CTA area and the portrait — reading as a separate section rather
         than one continuous hero. A single ~5rem (80px) gap, sourced from
         this grid gap alone (portrait's margin-top zeroed out below),
         replaces both. Desktop's two-column --s8 gap is untouched above. */
      gap: 4rem;
      text-align: center;
      justify-items: center;
    }

    .hero__copy h1 {
      /* 19ch (set above, unconditionally) is tuned for the desktop
         two-column hero, where a narrower, taller-flowing heading balances
         the portrait beside it. With that column gone, the same cap just
         wraps the same headline into far more lines than the full-width
         container needs — let it use the whole available width instead. */
      max-width: none;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__portrait {
      justify-self: center;
      max-width: 208px;
      margin-top: 0;
    }

    .hero__portrait-caption {
      align-items: center;
      text-align: center;
    }
  }
</style>
