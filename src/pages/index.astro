---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { businessName, businessSlogan, valuesAndMission, defaultDescription, defaultKeywords } from '@/data/site'
import { areasOfPractice } from '@/data/practice-areas'
import { jordanRyan } from '@/data/people'
import { legalServiceJsonLd, websiteJsonLd, webPageJsonLd, jordanRyanId } from '@/lib/json-ld'

const jsonLd = [
  legalServiceJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/',
    name: `${businessName} - Commercial Real Estate Law Firm`,
    description: defaultDescription,
    // Single-entry breadcrumb (Home alone) is intentionally omitted by webPageJsonLd.
    breadcrumbs: [{ name: 'Home', path: '/' }],
    mentions: [{ '@id': jordanRyanId }],
  }),
]

// Credential and numerical-stat items are interleaved (not grouped) so the
// strip alternates weight rather than front-loading either shape. See
// .proof-figure--credential / --stat below for the differing typographic
// treatment each variant gets.
const proofItems = [
  {
    variant: 'credential',
    value: 'Former Chief Legal Officer',
    label: 'National industrial & multifamily developer',
  },
  {
    variant: 'stat',
    value: '$60M',
    label: 'Construction financing transaction',
  },
  {
    variant: 'credential',
    value: 'Board Certified',
    label: 'Commercial Real Estate Law — Texas',
  },
  {
    variant: 'stat',
    value: '4M+ Sq. Ft.',
    label: 'Industrial & office leases negotiated',
  },
] as const
---

<BaseLayout
  title={businessName}
  description={defaultDescription}
  path="/"
  keywords={defaultKeywords}
  jsonLd={jsonLd}
  flushFooter
>
  <section class="hero page-section">
    <div class="hero__portrait">
      <img
        src="/square-profile-640.webp"
        srcset="/square-profile-440.webp 440w, /square-profile-640.webp 640w, /square-profile.webp 833w"
        sizes="(max-width: 860px) 220px, 320px"
        alt={jordanRyan.name}
        width="360"
        height="360"
      />
    </div>
    <div class="hero__copy">
      <span class="eyebrow">Dallas - Fort Worth, TX</span>
      <h1>Guiding Commercial Real Estate and Business Success.</h1>
      <p class="lead">{businessSlogan}</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn-primary">Schedule a Consultation</a>
      </div>
    </div>
  </section>

  <section class="proof-band" aria-label="Credentials and experience">
    <ul class="proof-strip proof-band__inner">
      {
        proofItems.map((item) => (
          <li class={`proof-figure proof-figure--${item.variant}`}>
            <span class="proof-figure__rule" />
            <span class="proof-figure__value">{item.value}</span>
            <span class="proof-figure__label">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section practice-overview">
    <div class="section-intro">
      <span class="eyebrow">What we handle</span>
      <h2>Practice areas</h2>
    </div>
    <ul class="practice-grid">
      {
        areasOfPractice.map((area) => (
          <li class="practice-grid__item">
            <h3>{area.name}</h3>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section values-mission">
    <div class="section-intro">
      <span class="eyebrow">What we do</span>
      <h2>Our Mission</h2>
    </div>
    <div class="values-mission__columns">
      {valuesAndMission.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="closing-band">
    <div class="closing-band__inner">
      <span class="closing-band__rule" aria-hidden="true"></span>
      <h2>Start with a conversation.</h2>
      <p class="lead">Get clear advice on what comes next—and experienced representation when you need it.</p>
      <a href="/contact" class="btn btn-primary">Request a consultation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: var(--s8);
    align-items: center;
    padding-top: var(--s9);
  }

  .hero__portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--rule);
  }

  .hero__copy h1 {
    max-width: 16ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s6);
    flex-wrap: wrap;
    margin-top: var(--s5);
  }

  /* A shallow, full-bleed tinted band — the first clearly perceptible
     boundary in the page, distinguishing verified figures from the
     surrounding editorial copy without introducing a new page color. */
  .proof-band {
    width: 100%;
    background: var(--bg-raised-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .proof-band__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s6) var(--s5);
    /* Four items divide evenly into either 2 or 4 columns, so there's no
       orphan risk at any width the way there was with five — no last-item
       span-fix needed. 4-up by default (four short items fit comfortably
       in a row down to fairly narrow widths); 2-up only once that row
       actually gets tight, reusing the existing .page-section mobile
       breakpoint rather than a one-off value. */
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s6) var(--s5);
    /* Top-align every item's own content instead of stretching it to match
       the tallest neighbor — with a two-line credential headline next to a
       one-line stat, stretch would center the shorter one and read as
       misaligned rather than intentional. */
    align-items: start;
  }

  @media (max-width: 640px) {
    .proof-band__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Credential items (title + context, e.g. "Board Certified") get a
     serif headline sized down from the base primitive's giant numeral
     treatment, but only enough to read as a distinct shape next to the
     stat items — not so far down that it loses visual presence next to
     them. The supporting caption intentionally reuses the base
     .proof-figure__label treatment untouched (see below) so both variants
     read as one consistent secondary layer. */
  .proof-figure--credential .proof-figure__value {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.25;
  }

  /* Credential captions run longer than typical stat captions, so they get
     a wider max-width than the base primitive's 16ch — applied to the
     label text itself (controlling line length) rather than to the item,
     which stays full-width for grid alignment (see 2x2 alignment fix
     below). */
  .proof-figure--credential .proof-figure__label {
    max-width: 28ch;
  }

  /* Stat items (4M+ Sq. Ft., $60M) keep the base primitive's large numeral
     and label treatment untouched — they're the visual anchors of the
     strip. */

  /* A deliberate compositional restart after the proof band: centered
     eyebrow/heading (breaking from the hero's left alignment) under a short
     gold rule, rather than just resuming the same left-aligned flow. Shared
     verbatim by Practice Areas and Vision & Mission below — both are the
     same "compositional restart" device, not two coincidentally-identical
     ones, so they share one class rather than two page-local copies. */
  .section-intro {
    text-align: center;
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding-top: var(--s2);
  }

  .section-intro::before {
    content: '';
    display: block;
    width: 40px;
    height: 2px;
    background: var(--gold-accent);
    margin: 0 auto var(--s5);
  }

  .section-intro .eyebrow {
    margin-bottom: var(--s2);
  }

  .section-intro h2 {
    margin-bottom: 0;
  }

  .practice-grid {
    list-style: none;
    margin: var(--s8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s6);
  }

  /* Plain name list for now — no per-area detail page to link to and no
     teaser copy yet (see src/data/practice-areas.ts). */
  .practice-grid__item h3 {
    margin: 0;
    color: var(--fg);
  }

  /* Deliberately plain, not a raised band: Practice Areas and Mission are
     meant to read as one connected chapter — "what we do" and "why we do
     it" — sharing the same page background rather than being split into
     separate visual movements. A full hairline the width of the content
     column (not full-bleed) is enough separation without implying a new
     section of the page has begun. Reuses the same .section-intro
     "compositional restart" treatment as Practice Areas above it. The
     paragraph stays left-aligned since centered multi-line body text is
     hard to read.

     The rule's own box is shrunk by the same amount as .page-section's
     horizontal padding (moved here into width/max-width via calc, rather
     than kept as padding) so the hairline lands exactly where the
     surrounding sections' text starts/stops, at every viewport width —
     not just on desktop, where the leftover viewport space outside
     max-width happened to hide the difference. */
  .values-mission {
    border-top: 1px solid var(--rule);
    width: calc(100% - var(--s5) * 2);
    max-width: calc(var(--content-width) - var(--s5) * 2);
    padding-left: 0;
    padding-right: 0;
  }

  @media (max-width: 640px) {
    .values-mission {
      width: calc(100% - var(--s4) * 2);
      max-width: calc(var(--content-width) - var(--s4) * 2);
    }
  }

  .values-mission__columns {
    max-width: var(--content-narrow);
    margin: var(--s7) auto 0;
    text-align: left;
  }

  .values-mission__columns p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: var(--s6);
    }

    .hero__portrait {
      max-width: 220px;
      margin: 0 auto;
    }

    .hero__copy h1 {
      /* 16ch (set above, unconditionally) is tuned for the desktop
         two-column hero, where a narrow, tall-flowing heading balances the
         portrait beside it. With that column gone, the same cap just wraps
         the same headline into far more lines than the full-width
         container needs — let it use the whole available width instead. */
      max-width: none;
    }

    .hero__actions {
      justify-content: center;
    }
  }
</style>
