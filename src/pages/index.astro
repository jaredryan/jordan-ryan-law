---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { businessName, businessSlogan, valuesAndMission, defaultDescription, defaultKeywords } from '@/data/site'
import { areasOfPractice } from '@/data/practice-areas'
import { ratingsAndDesignations } from '@/data/credentials'
import { russRyan } from '@/data/people'
import { legalServiceJsonLd, websiteJsonLd, webPageJsonLd, russRyanId, crystalBrightwellId } from '@/lib/json-ld'

const jsonLd = [
  legalServiceJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/',
    name: 'Ryan Legal, PC - California Employment & Business Law Firm',
    description: defaultDescription,
    // Single-entry breadcrumb (Home alone) is intentionally omitted by webPageJsonLd.
    breadcrumbs: [{ name: 'Home', path: '/' }],
    mentions: [{ '@id': russRyanId }, { '@id': crystalBrightwellId }],
  }),
]

// Every figure below is sourced verbatim from src/data — nothing here is
// invented. See docs/legacy-content-inventory.md for provenance.
const superLawyerRating = ratingsAndDesignations.find((r) => r.simplified.includes('Super Lawyer'))
const superLawyerStartYear = superLawyerRating ? parseInt(superLawyerRating.years, 10) : NaN
// +1: an inclusive year count (named every year from superLawyerStartYear
// through the current year, e.g. 2014-2026 is 13 years, not 12).
const superLawyerYears = Number.isNaN(superLawyerStartYear) ? undefined : new Date().getFullYear() - superLawyerStartYear + 1

const proofItems = [
  { value: '35+', label: 'Years in Practice' },
  { value: '90%', label: 'Prevailed at Trial or Arbitration' },
  { value: 'AV', label: 'Preeminent Rated, Martindale-Hubbell' },
  { value: superLawyerYears ? `${superLawyerYears}+` : '10+', label: 'Years Named a Super Lawyer' },
]
---

<BaseLayout title={businessName} description={defaultDescription} path="/" keywords={defaultKeywords} jsonLd={jsonLd} flushFooter>
  <section class="hero page-section">
    <div class="hero__portrait">
      <img
        src="/square-profile-640.webp"
        srcset="/square-profile-440.webp 440w, /square-profile-640.webp 640w, /square-profile.webp 833w"
        sizes="(max-width: 860px) 220px, 320px"
        alt={russRyan.name}
        width="360"
        height="360"
      />
    </div>
    <div class="hero__copy">
      <span class="eyebrow">Fresno, California</span>
      <h1>Practical day-to-day counsel. Strong representation when the stakes are high.</h1>
      <p class="lead">{businessSlogan}</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn-primary">Schedule a Consultation</a>
        <a href="/expertise" class="link-editorial">
          See areas of practice <span class="link-editorial__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="proof-band" aria-label="By the numbers">
    <ul class="proof-strip proof-band__inner">
      {
        proofItems.map((item) => (
          <li class="proof-figure">
            <span class="proof-figure__rule" />
            <span class="proof-figure__value">{item.value}</span>
            <span class="proof-figure__label">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section practice-overview">
    <div class="section-intro">
      <span class="eyebrow">What we handle</span>
      <h2>Practice areas</h2>
    </div>
    <ul class="practice-grid">
      {
        areasOfPractice.map((area) => (
          <li class="practice-grid__item">
            <a class="practice-grid__link" href={`/expertise#${area.slug}`}>
              <h3>
                {area.name} <span class="practice-grid__arrow" aria-hidden="true">→</span>
              </h3>
              <p>{area.teaser}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section values-mission">
    <div class="section-intro">
      <span class="eyebrow">How we work</span>
      <h2>Our Vision and Mission</h2>
    </div>
    <div class="values-mission__columns">
      {valuesAndMission.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="closing-band">
    <div class="closing-band__inner">
      <span class="closing-band__rule" aria-hidden="true"></span>
      <h2>Start with a conversation.</h2>
      <p class="lead">Get clear advice on what comes next—and experienced representation when you need it.</p>
      <a href="/contact" class="btn btn-primary">Request a consultation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: var(--s8);
    align-items: center;
    padding-top: var(--s9);
  }

  .hero__portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--rule);
  }

  .hero__copy h1 {
    max-width: 16ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s6);
    flex-wrap: wrap;
    margin-top: var(--s5);
  }

  /* A shallow, full-bleed tinted band — the first clearly perceptible
     boundary in the page, distinguishing verified figures from the
     surrounding editorial copy without introducing a new page color. */
  .proof-band {
    width: 100%;
    background: var(--bg-raised-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .proof-band__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s6) var(--s5);
    /* Four items divide evenly into either 2 or 4 columns, so there's no
       orphan risk at any width the way there was with five — no last-item
       span-fix needed. 4-up by default (four short items fit comfortably
       in a row down to fairly narrow widths); 2-up only once that row
       actually gets tight, reusing the existing .page-section mobile
       breakpoint rather than a one-off value. */
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s6) var(--s5);
  }

  @media (max-width: 640px) {
    .proof-band__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* A deliberate compositional restart after the proof band: centered
     eyebrow/heading (breaking from the hero's left alignment) under a short
     gold rule, rather than just resuming the same left-aligned flow. Shared
     verbatim by Practice Areas and Vision & Mission below — both are the
     same "compositional restart" device, not two coincidentally-identical
     ones, so they share one class rather than two page-local copies. */
  .section-intro {
    text-align: center;
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding-top: var(--s2);
  }

  .section-intro::before {
    content: '';
    display: block;
    width: 40px;
    height: 2px;
    background: var(--gold-accent);
    margin: 0 auto var(--s5);
  }

  .section-intro .eyebrow {
    margin-bottom: var(--s2);
  }

  .section-intro h2 {
    margin-bottom: 0;
  }

  .practice-grid {
    list-style: none;
    margin: var(--s8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s6);
  }

  /* The whole item is one clickable region — a single semantic link wrapping
     the heading and teaser, not nested links — but the visual affordance
     stays on the heading itself: one composition (persistent underline +
     arrow), not a separate card surface layered on top of it. */
  .practice-grid__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .practice-grid__item h3 {
    margin-bottom: var(--s2);
  }

  /* A real text-decoration underline rather than border-bottom: border-bottom
     draws one straight line under the element's whole box, which looks fine
     on a single line but produces a rigid bar with no breathing room under a
     second wrapped line (e.g. "Business Transactions and Finance"). A text
     underline is drawn per line by the browser instead, with room to set its
     own thickness/offset independent of the border box. Matches the visual
     strength of .link-editorial's 2px gold treatment without sharing its
     border-based implementation, since that one is reliably single-line.

     Underline is transparent at rest and the arrow below is the persistent
     resting-state cue instead, matching the .link-editorial precedent used
     twice already on this page: arrow always visible, underline reveals on
     hover/focus. (That pattern also colors the link text itself, which
     already signals "link" before the arrow or underline; these headings
     keep ordinary heading color, so the arrow — a shape cue, not a color
     one — carries the resting-state signal on its own.) */
  .practice-grid__item h3 {
    color: var(--fg);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: calc(0.18em + 1.5px);
    text-decoration-skip-ink: auto;
    transition: text-decoration-color var(--transition-fast);
  }

  .practice-grid__link:hover h3,
  .practice-grid__link:focus-visible h3 {
    text-decoration-color: var(--gold);
  }

  /* Opts out of the h3 underline (matches .link-editorial__arrow) so the
     persistent directional cue doesn't read as sitting on its own
     underlined line — muted at rest, gold and nudged right on hover/focus. */
  .practice-grid__arrow {
    text-decoration-line: none;
    display: inline-block;
    color: var(--fg-soft);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .practice-grid__link:hover .practice-grid__arrow,
  .practice-grid__link:focus-visible .practice-grid__arrow {
    color: var(--gold);
    transform: translateX(3px);
  }

  .practice-grid__item p {
    color: var(--fg-soft);
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Deliberately plain, not a raised band: Practice Areas and Vision &
     Mission are meant to read as one connected chapter — "what we do" and
     "why we do it" — sharing the same page background rather than being
     split into separate visual movements. A full hairline the width of the
     content column (not full-bleed) is enough separation without implying
     a new section of the page has begun. Reuses the same .section-intro
     "compositional restart" treatment as Practice Areas above it. The two
     paragraphs below stay left-aligned and split into columns since
     centered multi-line body text is hard to read, and the two are close
     enough in length to balance evenly.

     The rule's own box is shrunk by the same amount as .page-section's
     horizontal padding (moved here into width/max-width via calc, rather
     than kept as padding) so the hairline lands exactly where the
     surrounding sections' text starts/stops, at every viewport width —
     not just on desktop, where the leftover viewport space outside
     max-width happened to hide the difference. */
  .values-mission {
    border-top: 1px solid var(--rule);
    width: calc(100% - var(--s5) * 2);
    max-width: calc(var(--content-width) - var(--s5) * 2);
    padding-left: 0;
    padding-right: 0;
  }

  @media (max-width: 640px) {
    .values-mission {
      width: calc(100% - var(--s4) * 2);
      max-width: calc(var(--content-width) - var(--s4) * 2);
    }
  }

  .values-mission__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s6) var(--s8);
    margin-top: var(--s7);
    text-align: left;
  }

  .values-mission__columns p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .values-mission__columns {
      grid-template-columns: 1fr;
      gap: var(--s5);
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: var(--s6);
    }

    .hero__portrait {
      max-width: 220px;
      margin: 0 auto;
    }

    .hero__copy h1 {
      /* 16ch (set above, unconditionally) is tuned for the desktop
         two-column hero, where a narrow, tall-flowing heading balances the
         portrait beside it. With that column gone, the same cap just wraps
         the same headline into far more lines than the full-width
         container needs — let it use the whole available width instead. */
      max-width: none;
    }

    .hero__actions {
      justify-content: center;
    }

    /* Each proof item centered within its own grid quadrant as a block —
       same technique as the footer's multi-column layout (justify-items on
       the grid, not text-align on the item). The rule, value, and label
       stay left aligned relative to each other inside that now-centered,
       shrink-to-fit box. */
    .proof-band__inner {
      justify-items: center;
    }
  }
</style>
