---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { businessName, businessSlogan, businessExplanation, defaultDescription, defaultKeywords } from '@/data/site'
import { areasOfPractice } from '@/data/practice-areas'
import { courtAdmissions, ratingsAndDesignations } from '@/data/credentials'
import { russRyan, crystalBrightwell } from '@/data/people'
import { legalServiceJsonLd, websiteJsonLd, webPageJsonLd, russRyanId, crystalBrightwellId } from '@/lib/json-ld'

const jsonLd = [
  legalServiceJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/',
    name: 'Ryan Legal, PC - California Employment & Business Law Firm',
    description: defaultDescription,
    // Single-entry breadcrumb (Home alone) is intentionally omitted by webPageJsonLd.
    breadcrumbs: [{ name: 'Home', path: '/' }],
    mentions: [{ '@id': russRyanId }, { '@id': crystalBrightwellId }],
  }),
]

// Every figure below is sourced verbatim from src/data — nothing here is
// invented. See docs/legacy-content-inventory.md for provenance.
const superLawyerRating = ratingsAndDesignations.find((r) => r.simplified.includes('Super Lawyer'))
const superLawyerStartYear = superLawyerRating ? parseInt(superLawyerRating.years, 10) : NaN
const superLawyerYears = Number.isNaN(superLawyerStartYear) ? undefined : new Date().getFullYear() - superLawyerStartYear

const proofItems = [
  { value: '35+', label: 'Years in Practice' },
  { value: '90%', label: 'Prevailed at Trial or Arbitration' },
  { value: String(courtAdmissions.length), label: 'Federal & State Courts Admitted' },
  { value: 'AV', label: 'Preeminent Rated, Martindale-Hubbell' },
  { value: superLawyerYears ? `${superLawyerYears}+` : '10+', label: 'Years Named a Super Lawyer' },
]

const recordItems = ratingsAndDesignations.slice(0, 3)
---

<BaseLayout title={businessName} description={defaultDescription} path="/" keywords={defaultKeywords} jsonLd={jsonLd} flushFooter>
  <section class="hero page-section">
    <div class="hero__portrait">
      <img src="/square-profile.webp" alt={russRyan.name} width="360" height="360" />
    </div>
    <div class="hero__copy">
      <span class="eyebrow">Fresno, California</span>
      <h1>Practical day-to-day counsel. Strong representation when the stakes are high.</h1>
      <p class="lead">{businessSlogan}</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn-primary">Schedule a Consultation</a>
        <a href="/expertise" class="link-editorial">
          See areas of practice <span class="link-editorial__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="proof-band" aria-label="By the numbers">
    <ul class="proof-strip proof-band__inner">
      {
        proofItems.map((item) => (
          <li class="proof-figure">
            <span class="proof-figure__rule" />
            <span class="proof-figure__value">{item.value}</span>
            <span class="proof-figure__label">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section practice-overview">
    <div class="practice-overview__intro">
      <span class="eyebrow">What we handle</span>
      <h2>Practice areas</h2>
    </div>
    <ul class="practice-grid">
      {
        areasOfPractice.map((area) => (
          <li class="practice-grid__item">
            <h3>
              <a href={`/expertise#${area.slug}`}>{area.name}</a>
            </h3>
            <p>{area.teaser}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section record">
    <div class="record__intro">
      <span class="eyebrow">A record you can verify</span>
      <h2>Results, not just promises</h2>
      {businessExplanation.slice(0, 1).map((paragraph) => <p>{paragraph}</p>)}
      <a href="/about#credentials" class="link-editorial">
        Full credentials and admissions <span class="link-editorial__arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="record__list">
      {
        recordItems.map((item) => (
          <li class="proof-callout">
            <span class="proof-callout__label">{item.years}</span>
            <p class="proof-callout__body">{item.simplified}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section quote-section">
    <div class="quote-section__mark">
      <blockquote>
        "The best measure of my work is that clients stay—many for decades. They know they'll get practical counsel,
        honest advice, and strong representation when they need it."
      </blockquote>
      <p class="quote-section__attribution">— Russ Ryan</p>
    </div>
    <p class="quote-section__crystal">
      For scheduling and questions along the way, {crystalBrightwell.name} — with the firm {crystalBrightwell.tenureYears} years — helps
      keep things moving.
    </p>
  </section>

  <section class="close-section">
    <div class="close-section__inner">
      <span class="close-section__rule" aria-hidden="true"></span>
      <h2>Start with a conversation.</h2>
      <p class="lead">Get clear advice on what comes next—and experienced representation when you need it.</p>
      <a href="/contact" class="btn btn-primary">Request a consultation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: var(--s8);
    align-items: center;
    padding-top: var(--s9);
  }

  .hero__portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--rule);
  }

  .hero__copy h1 {
    max-width: 16ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s6);
    flex-wrap: wrap;
    margin-top: var(--s5);
  }

  /* A shallow, full-bleed tinted band — the first clearly perceptible
     boundary in the page, distinguishing verified figures from the
     surrounding editorial copy without introducing a new page color. */
  .proof-band {
    width: 100%;
    background: var(--bg-raised-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .proof-band__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s6) var(--s5);
    /* Five items: avoid an orphaned single item on the last row at
       in-between widths (auto-fit's default 140px minmax would produce a
       lonely 5th item around tablet widths). 2-up on phone (2 + 2 + 1,
       last item spans both columns rather than stranding it beside an
       empty cell), 3-up on tablet (3 + 2, no orphan), 5-up once the
       content column is wide enough to breathe. */
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s6) var(--s5);
  }

  .proof-figure:last-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 480px) and (max-width: 899px) {
    .proof-band__inner {
      grid-template-columns: repeat(3, 1fr);
    }

    .proof-figure:last-child {
      grid-column: auto;
    }
  }

  @media (min-width: 900px) {
    .proof-band__inner {
      grid-template-columns: repeat(5, 1fr);
    }

    .proof-figure:last-child {
      grid-column: auto;
    }
  }

  /* A deliberate compositional restart after the proof band: centered
     eyebrow/heading (breaking from the hero's left alignment) under a short
     gold rule, rather than just resuming the same left-aligned flow. */
  .practice-overview__intro {
    text-align: center;
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding-top: var(--s2);
  }

  .practice-overview__intro::before {
    content: '';
    display: block;
    width: 40px;
    height: 2px;
    background: var(--gold-accent);
    margin: 0 auto var(--s5);
  }

  .practice-overview__intro .eyebrow {
    margin-bottom: var(--s2);
  }

  .practice-overview__intro h2 {
    margin-bottom: 0;
  }

  .practice-grid {
    list-style: none;
    margin: var(--s8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s6);
  }

  .practice-grid__item h3 {
    margin-bottom: var(--s2);
  }

  /* A real text-decoration underline rather than border-bottom: border-bottom
     draws one straight line under the element's whole box, which looks fine
     on a single line but produces a rigid bar with no breathing room under a
     second wrapped line (e.g. "Business Transactions and Finance"). A text
     underline is drawn per line by the browser instead, with room to set its
     own thickness/offset independent of the border box. Matches the visual
     strength of .link-editorial's 2px gold treatment without sharing its
     border-based implementation, since that one is reliably single-line. */
  .practice-grid__item h3 a {
    color: var(--fg);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: calc(0.18em + 1.5px);
    text-decoration-skip-ink: auto;
    transition: text-decoration-color var(--transition-fast);
  }

  .practice-grid__item h3 a:hover,
  .practice-grid__item h3 a:focus-visible {
    text-decoration-color: var(--gold);
  }

  .practice-grid__item p {
    color: var(--fg-soft);
    font-size: 0.9375rem;
    margin: 0;
  }

  .record {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s8);
    background: var(--bg-raised);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .record__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s5);
  }

  .quote-section {
    max-width: var(--content-narrow);
    text-align: left;
  }

  /* Restrained pull-quote treatment: a gold vertical rule plus a soft warm
     wash that fades out rightward, rather than an enclosing bordered card
     (no right/top/bottom border, no radius) — reads as editorial emphasis,
     not a UI panel. Scoped to the quote+attribution only; the Crystal line
     below stays plain so this doesn't compete with the proof band above or
     the consultation band below. */
  .quote-section__mark {
    border-left: 3px solid var(--gold-accent);
    padding: var(--s5) var(--s5) var(--s5) var(--s6);
    background: linear-gradient(to right, var(--bg-raised-2), transparent 85%);
  }

  .quote-section__mark blockquote {
    margin: 0;
  }

  .quote-section__attribution {
    margin-top: var(--s4);
    margin-bottom: 0;
    font-weight: 700;
  }

  .quote-section__flag {
    font-weight: 400;
    color: var(--fg-soft);
    font-size: 0.85rem;
  }

  .quote-section__crystal {
    margin-top: var(--s6);
    padding-top: var(--s6);
    border-top: 1px solid var(--rule);
    color: var(--fg-soft);
  }

  /* A deliberate full-bleed navy "destination" band — the one place on the
     page besides the header/footer where navy carries real weight, using a
     deeper shade (--surface-consult) so it never reads as a repeat of the
     header/footer navy above or the footer navy just below it.

     This section is deliberately NOT `.on-navy`: unlike the header/footer,
     it isn't navy in both themes (dark theme flips it to ivory below), so
     borrowing that utility would be misleading and would tie its focus/
     button color to an unrelated shared class. --close-focus-color is a
     local custom property instead — ivory by default (light theme's navy
     surface, gold button — matches the header CTA's ivory-on-gold focus),
     redefined to gold for dark theme's ivory surface, navy button — so the
     one outline-color rule further down never needs its own theme check. */
  .close-section {
    --close-focus-color: var(--ivory);
    width: 100%;
    background: var(--surface-consult);
    text-align: center;
  }

  /* Replicates .on-navy's gold-button treatment locally, since this section
     no longer carries that class. Dark theme overrides this back to navy
     further down (its own surface is ivory there, not navy). */
  .close-section .btn-primary {
    background: var(--gold);
    color: var(--navy-deep);
  }

  .close-section .btn-primary:hover,
  .close-section .btn-primary:focus-visible {
    background: #ffc548;
  }

  .close-section a:focus-visible {
    outline-color: var(--close-focus-color);
  }

  .close-section__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding: var(--s9) var(--s5);
  }

  .close-section__rule {
    display: block;
    width: 40px;
    height: 2px;
    background: var(--gold-accent);
    margin: 0 auto var(--s5);
  }

  .close-section h2 {
    color: var(--surface-navy-fg);
  }

  .close-section .lead {
    color: var(--surface-navy-fg-soft);
    margin: 0 auto var(--s6);
  }

  /* Dark theme: the deep-navy band reads as just another dark surface next
     to Home's other alternating dark sections, losing the light-theme
     version's contrast/impact. Flip to a warm ivory surface instead — dark
     navy text/button, a restrained gold-ink rule — so the band still reads
     as a deliberate "destination" moment, just inverted. */
  :root[data-theme='dark'] .close-section {
    /* Neither navy (reads as "more button," even at ~11.7:1 contrast against
       the ivory page) nor gold (only ~1.5:1 against ivory — fails WCAG's 3:1
       non-text minimum outright) worked well here. This gold-ink-family
       brown is a different hue from both the navy button and the ivory
       background, so it reads as its own distinct ring rather than blending
       with either — and it clears the 3:1 minimum at ~5:1. Hardcoded rather
       than referencing --gold-ink: that token is now tuned for legibility
       against the dark navy --bg (Expertise's chapter numbers, eyebrows),
       a different surface than this band's ivory one — the two contexts
       need different values, so they can't share the same token. */
    --close-focus-color: #8a5a00;
    background: var(--ivory);
  }

  :root[data-theme='dark'] .close-section__rule {
    background: #8a5a00;
  }

  :root[data-theme='dark'] .close-section h2,
  :root[data-theme='dark'] .close-section .lead {
    color: var(--navy-deep);
  }

  :root[data-theme='dark'] .close-section .btn-primary {
    background: var(--navy);
    color: #fff;
  }

  :root[data-theme='dark'] .close-section .btn-primary:hover,
  :root[data-theme='dark'] .close-section .btn-primary:focus-visible {
    background: var(--navy-deep);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: var(--s6);
    }

    .hero__portrait {
      max-width: 220px;
      margin: 0 auto;
    }

    .hero__copy h1 {
      /* 16ch (set above, unconditionally) is tuned for the desktop
         two-column hero, where a narrow, tall-flowing heading balances the
         portrait beside it. With that column gone, the same cap just wraps
         the same headline into far more lines than the full-width
         container needs — let it use the whole available width instead. */
      max-width: none;
    }

    .hero__actions {
      justify-content: center;
    }

    .record {
      grid-template-columns: 1fr;
    }

    /* Major section header: matches the eyebrow/h2 centering already
       established on .practice-overview__intro above it — the explanatory
       paragraph, "full credentials" link, and the record__list stay left
       aligned. */
    .record__intro > .eyebrow,
    .record__intro > h2 {
      text-align: center;
    }
  }
</style>
