---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { businessName, businessSlogan, businessExplanation, defaultDescription, defaultKeywords } from '@/data/site'
import { areasOfPractice } from '@/data/practice-areas'
import { courtAdmissions, ratingsAndDesignations } from '@/data/credentials'
import { russRyan, crystalBrightwell } from '@/data/people'
import { legalServiceJsonLd, websiteJsonLd, webPageJsonLd } from '@/lib/json-ld'

const jsonLd = [
  legalServiceJsonLd(),
  websiteJsonLd(),
  webPageJsonLd({
    path: '/',
    name: 'Ryan Legal, PC - California Employment & Business Law Firm',
    description: defaultDescription,
    breadcrumbs: [{ name: 'Home', path: '/' }],
  }),
]

// Every figure below is sourced verbatim from src/data — nothing here is
// invented. See docs/legacy-content-inventory.md for provenance.
const superLawyerRating = ratingsAndDesignations.find((r) => r.simplified.includes('Super Lawyer'))
const superLawyerStartYear = superLawyerRating ? parseInt(superLawyerRating.years, 10) : NaN
const superLawyerYears = Number.isNaN(superLawyerStartYear) ? undefined : new Date().getFullYear() - superLawyerStartYear

const proofItems = [
  { value: '35+', label: 'Years in Practice' },
  { value: '90%', label: 'Prevailed at Trial or Arbitration' },
  { value: String(courtAdmissions.length), label: 'Federal & State Courts Admitted' },
  { value: 'AV', label: 'Preeminent Rated, Martindale-Hubbell' },
  { value: superLawyerYears ? `${superLawyerYears}+` : '10+', label: 'Years Named a Super Lawyer' },
]

const recordItems = ratingsAndDesignations.slice(0, 3)
---

<BaseLayout title={businessName} description={defaultDescription} path="/" keywords={defaultKeywords} jsonLd={jsonLd}>
  <section class="hero page-section">
    <div class="hero__portrait">
      <img src="/square-profile.webp" alt={russRyan.name} width="360" height="360" />
    </div>
    <div class="hero__copy">
      <span class="eyebrow">Fresno, California</span>
      <h1>Direct access to one attorney who's spent thirty-five years earning it.</h1>
      <p class="lead">{businessSlogan}</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn-primary">Schedule a Consultation</a>
        <a href="/expertise" class="link-editorial">
          See areas of practice <span class="link-editorial__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="proof-band" aria-label="By the numbers">
    <ul class="proof-strip proof-band__inner">
      {
        proofItems.map((item) => (
          <li class="proof-figure">
            <span class="proof-figure__rule" />
            <span class="proof-figure__value">{item.value}</span>
            <span class="proof-figure__label">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section practice-overview">
    <div class="practice-overview__intro">
      <span class="eyebrow">What we handle</span>
      <h2>Practice areas</h2>
    </div>
    <ul class="practice-grid">
      {
        areasOfPractice.map((area) => (
          <li class="practice-grid__item">
            <h3>
              <a href={`/expertise#${area.slug}`}>{area.name}</a>
            </h3>
            <p>{area.teaser}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section record">
    <div class="record__intro">
      <span class="eyebrow">A record you can verify</span>
      <h2>Results, not just promises</h2>
      {businessExplanation.slice(0, 1).map((paragraph) => <p>{paragraph}</p>)}
      <a href="/about#credentials" class="link-editorial">
        Full credentials and admissions <span class="link-editorial__arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="record__list">
      {
        recordItems.map((item) => (
          <li class="proof-callout">
            <span class="proof-callout__label">{item.years}</span>
            <p class="proof-callout__body">{item.simplified}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section quote-section">
    <blockquote>
      "The best measure of my work is that clients stay—many for decades. They know they'll get practical counsel,
      honest advice, and strong representation when they need it."
    </blockquote>
    <p class="quote-section__attribution">— Russ Ryan</p>
    <p class="quote-section__crystal">
      For scheduling and questions along the way, {crystalBrightwell.name} — with the firm {crystalBrightwell.tenureYears} years — helps
      keep things moving.
    </p>
  </section>

  <section class="close-section on-navy">
    <div class="close-section__inner">
      <span class="close-section__rule" aria-hidden="true"></span>
      <h2>Request a Consultation</h2>
      <p class="lead">Talk with the attorney who will actually handle your matter, start to finish.</p>
      <a href="/contact" class="btn btn-primary">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: var(--s8);
    align-items: center;
    padding-top: var(--s9);
  }

  .hero__portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--rule);
  }

  .hero__copy h1 {
    max-width: 16ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--s6);
    flex-wrap: wrap;
    margin-top: var(--s5);
  }

  /* A shallow, full-bleed tinted band — the first clearly perceptible
     boundary in the page, distinguishing verified figures from the
     surrounding editorial copy without introducing a new page color. */
  .proof-band {
    width: 100%;
    background: var(--bg-raised-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .proof-band__inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s6) var(--s5);
    /* Five items: avoid an orphaned single item on the last row at
       in-between widths (auto-fit's default 140px minmax would produce a
       lonely 5th item around tablet widths). Stack on mobile, 3-up on
       tablet (3 + 2, no orphan), 5-up once the content column is wide
       enough to breathe. */
    grid-template-columns: 1fr;
    gap: var(--s6) var(--s5);
  }

  @media (min-width: 480px) and (max-width: 899px) {
    .proof-band__inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .proof-band__inner {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  /* A deliberate compositional restart after the proof band: centered
     eyebrow/heading (breaking from the hero's left alignment) under a short
     gold rule, rather than just resuming the same left-aligned flow. */
  .practice-overview__intro {
    text-align: center;
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding-top: var(--s2);
  }

  .practice-overview__intro::before {
    content: '';
    display: block;
    width: 40px;
    height: 2px;
    background: var(--gold-accent);
    margin: 0 auto var(--s5);
  }

  .practice-overview__intro .eyebrow {
    margin-bottom: var(--s2);
  }

  .practice-overview__intro h2 {
    margin-bottom: 0;
  }

  .practice-grid {
    list-style: none;
    margin: var(--s8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--s6);
  }

  .practice-grid__item h3 {
    margin-bottom: var(--s2);
  }

  .practice-grid__item h3 a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .practice-grid__item h3 a:hover,
  .practice-grid__item h3 a:focus-visible {
    border-bottom-color: var(--gold-accent);
  }

  .practice-grid__item p {
    color: var(--fg-soft);
    font-size: 0.9375rem;
    margin: 0;
  }

  .record {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s8);
    background: var(--bg-raised);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .record__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s5);
  }

  .quote-section {
    max-width: var(--content-narrow);
    text-align: left;
  }

  .quote-section__attribution {
    margin-top: var(--s4);
    font-weight: 700;
  }

  .quote-section__flag {
    font-weight: 400;
    color: var(--fg-soft);
    font-size: 0.85rem;
  }

  .quote-section__crystal {
    margin-top: var(--s6);
    padding-top: var(--s6);
    border-top: 1px solid var(--rule);
    color: var(--fg-soft);
  }

  /* A deliberate full-bleed navy "destination" band — the one place on the
     page besides the header/footer where navy carries real weight, using a
     deeper shade (--surface-consult) so it never reads as a repeat of the
     header/footer navy above or the footer navy just below it. */
  .close-section {
    width: 100%;
    background: var(--surface-consult);
    text-align: center;
  }

  .close-section__inner {
    max-width: var(--content-narrow);
    margin: 0 auto;
    padding: var(--s9) var(--s5);
  }

  .close-section__rule {
    display: block;
    width: 40px;
    height: 2px;
    background: var(--gold-accent);
    margin: 0 auto var(--s5);
  }

  .close-section h2 {
    color: var(--surface-navy-fg);
  }

  .close-section .lead {
    color: var(--surface-navy-fg-soft);
    margin: 0 auto var(--s6);
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: left;
      padding-top: var(--s6);
    }

    .hero__portrait {
      max-width: 220px;
    }

    .record {
      grid-template-columns: 1fr;
    }
  }
</style>
