---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Page not found" path="/404" flushFooter noindex>
  <section class="notfound">
    <div class="notfound__inner">
      <img src="/r-mark-transparent.webp" alt="" width="64" height="64" class="notfound__mark notfound__mark--light" />
      <img
        src="/r-mark-transparent-on-dark.webp"
        alt=""
        width="64"
        height="64"
        class="notfound__mark notfound__mark--dark"
      />
      <h1>Page not found</h1>
      <p class="lead">The page may have moved, or the address may be incorrect.</p>
      <a href="/" class="btn btn-primary">Return Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* main is a flex item (BaseLayout's body is flex-direction: column,
     main: flex: 1), so it already fills exactly the space between the
     header and footer on short-content pages like this one. Making main
     itself a flex container lets .notfound stretch to fill that space and
     center within it, instead of centering within an arbitrary min-height
     guess — so the block reads as centered in the real usable area at any
     viewport height, short laptop or tall desktop alike. */
  :global(main) {
    display: flex;
    flex-direction: column;
  }

  .notfound {
    flex: 1;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s7) var(--s5);
    text-align: center;
  }

  .notfound__inner {
    max-width: 36ch;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .notfound__mark {
    display: block;
    width: clamp(72px, 7vw, 96px);
    height: auto;
    aspect-ratio: 1 / 1;
    margin-bottom: var(--s5);
  }

  /* The navy mark reads fine against light-theme --bg, but has too little
     contrast against dark-theme's near-black --bg — swap to the ivory
     recolor rather than reintroduce a badge/halo behind it. */
  .notfound__mark--dark {
    display: none;
  }

  :root[data-theme='dark'] .notfound__mark--light {
    display: none;
  }

  :root[data-theme='dark'] .notfound__mark--dark {
    display: block;
  }

  .notfound h1 {
    margin-bottom: var(--s3);
  }

  .notfound .lead {
    margin-bottom: var(--s6);
  }
</style>
