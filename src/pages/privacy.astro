---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { contact, businessName } from '@/data/site'
import { webPageJsonLd } from '@/lib/json-ld'

const description = `How ${businessName} collects, uses, and protects information submitted through this website.`

const jsonLd = [
  webPageJsonLd({
    path: '/privacy',
    name: 'Privacy Policy',
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Privacy Policy', path: '/privacy' },
    ],
  }),
]
---

<BaseLayout title="Privacy Policy" description={description} path="/privacy" jsonLd={jsonLd}>
  <section class="page-section page-section--narrow privacy-section">
    <div class="page-hero">
      <span class="eyebrow">Privacy Policy</span>
      <h1>Privacy Policy</h1>
      <p class="lead">
        Effective July 21, 2026. This page explains what information this website collects and how it is used.
      </p>
    </div>

    <div class="privacy-block">
      <h2>Information we collect</h2>
      <p>
        The only personal information this website collects is what you choose to submit through the contact form on our <a
          href="/contact">Contact</a
        > page: your name, phone number, email address, and the details of your message. We do not use analytics, advertising,
        or tracking cookies of any kind.
      </p>
    </div>

    <div class="privacy-block">
      <h2>How we use your information</h2>
      <p>
        Information submitted through the contact form is used solely to respond to your inquiry. We do not sell, rent,
        or share your information with third parties for marketing purposes.
      </p>
    </div>

    <div class="privacy-block">
      <h2>Third-party service providers</h2>
      <p>
        We use Resend, a transactional email provider, solely to deliver contact form submissions to our office. Resend
        does not use your information for any purpose beyond that delivery.
      </p>
    </div>

    <div class="privacy-block">
      <h2>Local storage</h2>
      <p>
        This site remembers your light/dark theme preference using your browser's local storage. This value never leaves
        your device and is not used to identify or track you.
      </p>
    </div>

    <div class="privacy-block">
      <h2>Data retention</h2>
      <p>
        Contact form submissions are retained as ordinary business correspondence for as long as reasonably necessary to
        respond to and document your inquiry.
      </p>
    </div>

    <div class="privacy-block">
      <h2>Your rights</h2>
      <p>
        California residents may have rights regarding their personal information under California law, including the
        right to request access to or deletion of information we hold about you. To make a request, contact us using the
        details below.
      </p>
    </div>

    <div class="privacy-block">
      <h2>No attorney-client relationship</h2>
      <p>
        Submitting the contact form or otherwise contacting our office does not by itself create an attorney-client
        relationship.
      </p>
    </div>

    <div class="privacy-block">
      <h2>Changes to this policy</h2>
      <p>We may update this policy from time to time. Any changes will be reflected on this page.</p>
    </div>

    <div class="privacy-block">
      <h2>Contact us</h2>
      <p>
        Questions about this policy can be directed to{' '}
        <a href={`mailto:${contact.emails.russ}`}>{contact.emails.russ}</a> or{' '}
        <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-block {
    margin-top: var(--s7);
  }

  .privacy-block h2 {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
  }

  .privacy-block p {
    margin-bottom: 0;
  }
</style>
