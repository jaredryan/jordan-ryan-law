---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { areasOfPractice } from '@/data/practice-areas'
import { webPageJsonLd, legalServiceJsonLd } from '@/lib/json-ld'

const description = `Explore Ryan Legal, PC's expertise in employment law, business transactions, health care law, technology law, and litigation.`
const keywords = [
  'Employment Law',
  'Business Law',
  'Healthcare Law',
  'Technology Law',
  'Litigation',
  'Appellate Law',
  'Corporate Transactions',
  'Real Estate Law',
  'Regulatory Compliance',
  'Trade Secret Protection',
]

const jsonLd = [
  legalServiceJsonLd(),
  webPageJsonLd({
    path: '/expertise',
    name: 'Ryan Legal, PC Expertise',
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Expertise', path: '/expertise' },
    ],
  }),
]

const pad = (n: number) => String(n).padStart(2, '0')
---

<BaseLayout title="Expertise" description={description} path="/expertise" keywords={keywords} jsonLd={jsonLd}>
  <div class="exp-layout">
    <aside class="exp-index" aria-label="Practice areas">
      <ol>
        {
          areasOfPractice.map((area, i) => (
            <li>
              <a href={`#${area.slug}`}>
                <span class="exp-index__num" aria-hidden="true">
                  {pad(i + 1)}
                </span>
                {area.name}
              </a>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="exp-main">
      <section class="exp-intro page-section page-section--narrow">
        <span class="eyebrow">Expertise</span>
        <h1>Where Ryan Legal focuses</h1>
        <p class="lead">
          Six practice areas, one attorney handling each matter directly — from day-to-day advising to trial and
          appeal.
        </p>
        <a href="/contact" class="link-editorial">
          Not sure where you fit? Ask Russ directly <span class="link-editorial__arrow" aria-hidden="true">→</span>
        </a>
      </section>

      <nav class="exp-chip-nav" aria-label="Practice areas">
        {
          areasOfPractice.map((area) => (
            <a href={`#${area.slug}`}>{area.name}</a>
          ))
        }
      </nav>

      <details class="exp-jump-nav">
        <summary>Jump to a practice area</summary>
        <ul>
          {
            areasOfPractice.map((area) => (
              <li>
                <a href={`#${area.slug}`}>{area.name}</a>
              </li>
            ))
          }
        </ul>
      </details>

      {
        areasOfPractice.map((area, i) => {
          const prev = areasOfPractice[i - 1]
          const next = areasOfPractice[i + 1]
          const aboutHref = area.proof?.linkHref ?? '/about#credentials'
          return (
            <article class="exp-section page-section page-section--narrow" id={area.slug}>
              <span class="exp-section__num" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <h2>{area.name}</h2>
              <p>{area.content}</p>

              <h3>What this covers</h3>
              <ul class="exp-covers">
                {area.whatThisCovers.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              {(area.clientTypes || area.proof) && (
                <div class="exp-compare">
                  {area.clientTypes && (
                    <div class="exp-compare__clients">
                      <h3>Client Types</h3>
                      <p>{area.clientTypes.join(', ')}</p>
                    </div>
                  )}
                  {area.proof && (
                    <div class="proof-callout exp-compare__proof">
                      <span class="proof-callout__label">{area.proof.label}</span>
                      <p class="proof-callout__body">{area.proof.body}</p>
                      <a href={area.proof.linkHref} class="link-editorial">
                        {area.proof.linkLabel} <span class="link-editorial__arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  )}
                </div>
              )}

              <div class="exp-section__actions">
                {!area.proof && (
                  <a href={aboutHref} class="link-editorial">
                    Learn more about Russ's credentials <span class="link-editorial__arrow" aria-hidden="true">→</span>
                  </a>
                )}
                <a href="/contact" class="btn btn-secondary">Discuss {area.name.toLowerCase()}</a>
              </div>

              {(prev || next) && (
                <nav class="exp-section__pager" aria-label="More practice areas">
                  {prev ? <a href={`#${prev.slug}`}>← {prev.name}</a> : <span />}
                  {next ? <a href={`#${next.slug}`}>{next.name} →</a> : <span />}
                </nav>
              )}
            </article>
          )
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .exp-layout {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
  }

  .exp-index {
    display: none;
  }

  .exp-main {
    min-width: 0;
  }

  .exp-chip-nav,
  .exp-jump-nav {
    display: none;
  }

  .exp-covers {
    padding-left: 1.25em;
    color: var(--fg);
  }

  .exp-covers li {
    margin-bottom: var(--s2);
  }

  .exp-section {
    position: relative;
    border-top: 1px solid var(--rule);
    padding-top: var(--s8);
  }

  .exp-section:first-of-type {
    border-top: none;
  }

  .exp-section__num {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--gold-ink);
    font-size: 1rem;
    display: block;
    margin-bottom: var(--s2);
  }

  :root[data-theme='dark'] .exp-section__num {
    color: var(--gold-accent);
  }

  .exp-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s6);
    margin: var(--s6) 0;
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
  }

  .exp-compare__clients h3,
  .exp-compare__proof h3 {
    margin-bottom: var(--s2);
  }

  .exp-compare__clients p {
    color: var(--fg-soft);
    margin: 0;
  }

  .exp-section__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s4);
    margin-top: var(--s6);
  }

  .exp-section__pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s4);
    margin-top: var(--s7);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
    font-weight: 600;
  }

  .exp-section__pager a {
    color: var(--fg);
    text-decoration: none;
  }

  .exp-section__pager a:hover,
  .exp-section__pager a:focus-visible {
    color: var(--navy);
  }

  :root[data-theme='dark'] .exp-section__pager a:hover,
  :root[data-theme='dark'] .exp-section__pager a:focus-visible {
    color: var(--gold-accent);
  }

  /* Portrait-tablet and mobile (<=880px): labeled jump control. */
  @media (max-width: 880px) {
    .exp-jump-nav {
      display: block;
      margin: 0 var(--s4) var(--s6);
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: var(--s3) var(--s4);
    }

    .exp-jump-nav summary {
      cursor: pointer;
      font-weight: 700;
    }

    .exp-jump-nav ul {
      list-style: none;
      margin: var(--s3) 0 0;
      padding: 0;
    }

    .exp-jump-nav li a {
      display: block;
      padding: var(--s2) 0;
      color: var(--fg);
      min-height: 44px;
      display: flex;
      align-items: center;
    }

    .exp-compare {
      grid-template-columns: 1fr;
    }
  }

  /* Condensed landscape-tablet / narrow-laptop (881–1099px): compact
     horizontal nav replaces the sidebar. */
  @media (min-width: 881px) and (max-width: 1099px) {
    .exp-chip-nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s3);
      padding: 0 var(--s5) var(--s6);
    }

    .exp-chip-nav a {
      padding: var(--s2) var(--s4);
      border: 1px solid var(--rule);
      border-radius: 999px;
      color: var(--fg);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .exp-chip-nav a:hover,
    .exp-chip-nav a:focus-visible {
      border-color: var(--navy);
    }

    :root[data-theme='dark'] .exp-chip-nav a:hover,
    :root[data-theme='dark'] .exp-chip-nav a:focus-visible {
      border-color: var(--gold-accent);
    }
  }

  /* Wide (>=1100px): persistent side index. */
  @media (min-width: 1100px) {
    .exp-layout {
      grid-template-columns: 230px 1fr;
      gap: var(--s7);
    }

    .exp-index {
      display: block;
      position: sticky;
      top: calc(var(--s8) + 60px);
      align-self: start;
      padding: var(--s6) var(--s5) var(--s6) 0;
      border-right: 1px solid var(--rule);
      max-height: calc(100vh - var(--s8) - 60px);
      overflow-y: auto;
    }

    .exp-index ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .exp-index li {
      border-bottom: 1px solid var(--rule);
    }

    .exp-index a {
      display: flex;
      align-items: baseline;
      gap: var(--s2);
      padding: var(--s3) 0;
      color: var(--fg-soft);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9375rem;
    }

    .exp-index a:hover,
    .exp-index a:focus-visible {
      color: var(--fg);
    }

    .exp-index__num {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--gold-ink);
      font-size: 0.8125rem;
    }

    :root[data-theme='dark'] .exp-index__num {
      color: var(--gold-accent);
    }

    .exp-intro {
      padding-left: var(--s6);
      max-width: none;
    }

    .exp-section {
      padding-left: var(--s6);
    }
  }
</style>
