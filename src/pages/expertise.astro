---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { areasOfPractice } from '@/data/practice-areas'
import { webPageJsonLd, legalServiceJsonLd } from '@/lib/json-ld'

const description = `Explore Ryan Legal, PC's expertise in employment law, business transactions, health care law, technology law, and litigation.`
const keywords = [
  'Employment Law',
  'Business Law',
  'Healthcare Law',
  'Technology Law',
  'Litigation',
  'Appellate Law',
  'Corporate Transactions',
  'Real Estate Law',
  'Regulatory Compliance',
  'Trade Secret Protection',
]

const jsonLd = [
  legalServiceJsonLd(),
  webPageJsonLd({
    path: '/expertise',
    name: 'Ryan Legal, PC Expertise',
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Expertise', path: '/expertise' },
    ],
  }),
]
---

<BaseLayout title="Expertise" description={description} path="/expertise" keywords={keywords} jsonLd={jsonLd} flushFooter>
  <div class="exp-layout">
    <aside class="exp-index" aria-label="Practice areas" data-spy-rail>
      <ol>
        {
          areasOfPractice.map((area) => (
            <li>
              <a href={`#${area.slug}`}>{area.name}</a>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="exp-main">
      <details class="exp-jump-nav" data-spy-rail>
        <summary>
          Jump to a practice area
          <svg class="jump-nav-chevron" width="16" height="16" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ul>
          {
            areasOfPractice.map((area) => (
              <li>
                <a href={`#${area.slug}`}>{area.name}</a>
              </li>
            ))
          }
        </ul>
      </details>

      <section class="exp-intro page-section page-section--narrow">
        <span class="eyebrow">Expertise</span>
        <h1>Areas of Practice</h1>
        <p class="lead">
          Six practice areas, one attorney handling each matter directly — from day-to-day advising to trial and
          appeal.
        </p>
        <a href="/contact" class="link-editorial">
          Not sure where you fit? Ask Russ directly <span class="link-editorial__arrow" aria-hidden="true">→</span>
        </a>
      </section>

      {
        areasOfPractice.map((area) => {
          const aboutHref = area.proof?.linkHref ?? '/about#credentials'
          return (
            <article class="exp-section page-section page-section--narrow" id={area.slug}>
              <span class="exp-section__rule" aria-hidden="true"></span>
              <h2>{area.name}</h2>
              <p>{area.content}</p>

              <h3>What this covers</h3>
              <ul class="exp-covers">
                {area.whatThisCovers.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              {(area.clientTypes || area.proof) && (
                <div class="exp-compare">
                  {area.clientTypes && (
                    <div class="exp-compare__clients">
                      <h3>Client Types</h3>
                      <p>{area.clientTypes.join(', ')}</p>
                    </div>
                  )}
                  {area.proof && (
                    <div class="proof-callout exp-compare__proof">
                      <span class="proof-callout__label">{area.proof.label}</span>
                      <p class="proof-callout__body">{area.proof.body}</p>
                      <a href={area.proof.linkHref} class="link-editorial">
                        {area.proof.linkLabel} <span class="link-editorial__arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  )}
                </div>
              )}

              <div class="exp-section__actions">
                {!area.proof && (
                  <a href={aboutHref} class="link-editorial">
                    Learn more about Russ's credentials <span class="link-editorial__arrow" aria-hidden="true">→</span>
                  </a>
                )}
                <a href="/contact" class="btn btn-secondary">Discuss {area.name.toLowerCase()}</a>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>

  <section class="closing-band">
    <div class="closing-band__inner">
      <span class="closing-band__rule" aria-hidden="true"></span>
      <h2>Let's find the right next step.</h2>
      <p class="lead">Get clear guidance on your options—before a decision, during a dispute, or in court.</p>
      <a href="/contact" class="btn btn-primary">Discuss your needs</a>
    </div>
  </section>
</BaseLayout>

<script src="@/scripts/scroll-spy.ts"></script>

<style>
  .exp-layout {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
  }

  .exp-index {
    display: none;
  }

  .exp-main {
    min-width: 0;
  }

  .exp-jump-nav {
    display: none;
  }

  .exp-covers {
    color: var(--fg);
  }

  /* The base reset sets `ul { list-style: none }` (see global.css) so every
     list renders identically across browsers — but that leaves this one
     genuine bulleted list with no marker at all. A manual gold dash
     (the same mark used for .exp-section__rule and the homepage intro
     dividers) replaces it, so the marker is identical in every browser
     instead of falling back to native ::marker rendering, which varies. */
  .exp-covers li {
    position: relative;
    padding-left: 1.25em;
    margin-bottom: var(--s2);
  }

  .exp-covers li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 2px;
    /* --gold-ink, not --gold-accent: the raw accent is ~1.7:1 against --bg
       in light theme, well under the 3:1 floor for a graphical marker
       (WCAG 1.4.11). --gold-ink is the token this codebase already reserves
       for gold that needs to stay legible (~5.6:1 light, ~5.3:1 dark). */
    background: var(--gold-ink);
  }

  .exp-section {
    position: relative;
    border-top: 1px solid var(--rule);
    padding-top: var(--s8);
  }

  .exp-section:first-of-type {
    /* No divider line here — it isn't separating this section from a
       previous one, just from the intro above it. No top padding either:
       the intro's own bottom padding already provides the gap, and
       stacking this section's padding-top on top of that just produced
       dead space with no divider to explain it (128px at desktop, where
       nothing sits between the two). The gold rule + h2 below still read
       clearly as "a section begins here" without it. */
    border-top: none;
    padding-top: 0;
  }

  /* Same short-gold-rule "a section begins here" cue as About's
     .about-heading-rule, minus a numeral — the six practice areas aren't a
     sequence (no area depends on or follows from another; a reader can
     start with any one), so numbering them the way About's list rail does
     would be decoration without meaning. The non-rail jump-nav already
     lists all six by name with no numbers, so this also removes the
     mismatch between an unnumbered nav and numbered section headers. */
  .exp-section__rule {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--gold-accent);
    margin-bottom: var(--s3);
  }

  /* A subtly raised/tinted surface distinguishes the client-type and
     case-record metadata from the primary explanatory copy above it,
     without boxing the whole section in a card. auto-fit (rather than a
     fixed 1fr 1fr) lets the single-child case — most areas define only
     `proof` or only `clientTypes`, not both — fill the full width instead
     of leaving an empty second column inside the tinted panel. */
  .exp-compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s6);
    margin: var(--s6) 0;
    padding: var(--s5);
    background: var(--bg-raised-2);
    border-radius: 4px;
  }

  .exp-compare__clients h3,
  .exp-compare__proof h3 {
    margin-bottom: var(--s2);
  }

  .exp-compare__clients p {
    color: var(--fg-soft);
    margin: 0;
  }

  .exp-compare__proof {
    padding-left: var(--s4);
    border-left: 2px solid var(--gold-accent);
  }

  .exp-section__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s4);
    margin-top: var(--s6);
  }

  /* Mobile (<=640px, matching .page-section's own mobile breakpoint): the
     actions row has too little width for space-between to read as
     intentional — stack and center the pair instead. */
  @media (max-width: 640px) {
    .exp-section__actions {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  /* Portrait-tablet and mobile (<=1099px, matching About's own rail
     breakpoint): sticky labeled jump control — the same pattern as
     About's .about-jump-nav, reused verbatim including its placement
     before the intro, so the nav is available immediately rather than
     appearing mid-scroll. */
  @media (max-width: 1099px) {
    .exp-jump-nav {
      display: block;
      /* No bottom margin — the intro's own top padding provides the gap
         below it; a margin here would stack on top of that and double the
         space. */
      margin: var(--s5) var(--s4) 0;
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: var(--s3) var(--s4);
      position: sticky;
      top: calc(var(--s4) + 60px);
      background: var(--bg);
      z-index: 10;
    }

    .exp-jump-nav summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s3);
      cursor: pointer;
      font-weight: 700;
    }

    /* Explicit chevron, identical across browsers — see global.css for why
       the native ::marker/::-webkit-details-marker is hidden instead of
       left to render differently per browser. A real inline SVG rather than
       a border-drawn ::after: the border-corner trick draws ink into only
       two of its box's four edges, so the visible mark sits off-center
       within its own box and needs a manual pixel correction to look
       centered — one that (on this element specifically) was visibly
       snapping into place a frame after page load. An SVG's mark is already
       centered in its own viewBox, so `align-items: center` on the flex
       parent centers it correctly with nothing to nudge or catch up. */
    .exp-jump-nav .jump-nav-chevron {
      flex-shrink: 0;
      transition: transform var(--transition-fast);
    }

    .exp-jump-nav[open] .jump-nav-chevron {
      transform: rotate(180deg);
    }

    .exp-jump-nav ul {
      list-style: none;
      margin: var(--s3) 0 0;
      padding: 0;
    }

    .exp-jump-nav li a {
      display: flex;
      align-items: center;
      min-height: 44px;
      color: var(--fg);
    }

    .exp-jump-nav li a.is-active {
      color: var(--navy);
      text-shadow: 0.2px 0 currentColor, -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .exp-jump-nav li a.is-active {
      color: var(--gold-accent);
    }

    /* Page header: matches the same eyebrow/h1 centering used on Home,
       About, and Contact once their two-column/rail layouts collapse. The
       intro's lead and "ask Russ" link are short enough to center along
       with it, same as Home's hero and Contact's hero. */
    .exp-intro {
      text-align: center;
    }

    /* Major section headers: the rule marker and the practice area's own
       name, centered as a unit — the explanatory paragraph, "What this
       covers" list, and CTA row that follow stay left aligned. */
    .exp-section__rule {
      margin-left: auto;
      margin-right: auto;
    }

    .exp-section > h2 {
      text-align: center;
    }
  }

  @media (max-width: 880px) {
    .exp-compare {
      grid-template-columns: 1fr;
    }
  }

  /* Wide (>=1100px): persistent side index. */
  @media (min-width: 1100px) {
    .exp-layout {
      grid-template-columns: 230px 1fr;
      gap: var(--s7);
    }

    .exp-index {
      display: block;
      position: sticky;
      top: calc(var(--s8) + 60px);
      align-self: start;
      padding: var(--s6) var(--s5) var(--s6) 0;
      border-right: 1px solid var(--rule);
      max-height: calc(100vh - var(--s8) - 60px);
      overflow-y: auto;
    }

    .exp-index ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .exp-index li {
      border-bottom: 1px solid var(--rule);
    }

    .exp-index a {
      display: block;
      padding: var(--s3) 0 var(--s3) var(--s3);
      border-left: 2px solid transparent;
      color: var(--fg-soft);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9375rem;
    }

    .exp-index a:hover,
    .exp-index a:focus-visible {
      color: var(--fg);
    }

    .exp-index a.is-active {
      border-left-color: var(--gold-accent);
      color: var(--navy);
      text-shadow: 0.2px 0 currentColor, -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .exp-index a.is-active {
      color: var(--fg);
    }

    .exp-intro {
      padding-left: var(--s6);
      max-width: none;
    }

    .exp-section {
      padding-left: var(--s6);
    }
  }
</style>
