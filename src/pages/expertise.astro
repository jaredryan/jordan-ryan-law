---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ExpertiseSection from '@/components/ExpertiseSection.astro'
import { areasOfPractice } from '@/data/practice-areas'
import { webPageJsonLd, legalServiceJsonLd } from '@/lib/json-ld'

const description = `Explore Ryan Legal, PC's expertise in employment law, business transactions, health care law, technology law, and litigation.`
const keywords = [
  'Employment Law',
  'Business Law',
  'Healthcare Law',
  'Technology Law',
  'Litigation',
  'Appellate Law',
  'Corporate Transactions',
  'Real Estate Law',
  'Regulatory Compliance',
  'Trade Secret Protection',
]

const jsonLd = [
  legalServiceJsonLd(),
  webPageJsonLd({
    path: '/expertise',
    name: 'Ryan Legal, PC Expertise',
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Expertise', path: '/expertise' },
    ],
  }),
]

---

<BaseLayout title="Expertise" description={description} path="/expertise" keywords={keywords} jsonLd={jsonLd} flushFooter>
  <div class="exp-layout">
    <aside class="exp-index" aria-label="Practice areas" data-spy-rail>
      <ol>
        {
          areasOfPractice.map((area) => (
            <li>
              <a href={`#${area.slug}`}>{area.name}</a>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="exp-main">
      <details class="exp-jump-nav" data-spy-rail>
        <summary>
          Jump to a practice area
          <svg class="jump-nav-chevron" width="16" height="16" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ul>
          {
            areasOfPractice.map((area) => (
              <li>
                <a href={`#${area.slug}`}>{area.name}</a>
              </li>
            ))
          }
        </ul>
      </details>

      <section class="exp-intro page-section page-section--narrow">
        <span class="eyebrow">Expertise</span>
        <h1>Areas of Practice</h1>
        <p class="lead">
          Six practice areas, one attorney handling each matter directly — from day-to-day advising to trial and
          appeal.
        </p>
        <a href="/contact" class="link-editorial">
          Not sure where you fit? Ask Russ directly <span class="link-editorial__arrow" aria-hidden="true">→</span>
        </a>
      </section>

      {areasOfPractice.slice(0, 3).map((area, index) => <ExpertiseSection area={area} isFirst={index === 0} />)}

      {/* Six identical-template sections in a row read as one long document
         with no chapter break. The back half gets a quiet background shift
         — no new copy, just a pacing device — rather than a second
         consultation-style band, which would wrongly imply a decision
         point mid-page. This wraps the full width of .exp-main's own
         column (not just the narrow centered reading measure each article
         uses) so the color genuinely reads as "the page changed" rather
         than a floating box with unexplained gutters on either side. */}
      <div class="exp-movement">
        {areasOfPractice.slice(3).map((area) => <ExpertiseSection area={area} />)}
      </div>
    </div>
  </div>

  <section class="closing-band">
    <div class="closing-band__inner">
      <span class="closing-band__rule" aria-hidden="true"></span>
      <h2>Let's find the right next step.</h2>
      <p class="lead">Get clear guidance on your options—before a decision, during a dispute, or in court.</p>
      <a href="/contact" class="btn btn-primary">Discuss your needs</a>
    </div>
  </section>
</BaseLayout>

<script src="@/scripts/scroll-spy.ts"></script>

<style>
  .exp-layout {
    max-width: var(--content-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
  }

  .exp-index {
    display: none;
  }

  .exp-main {
    min-width: 0;
  }

  .exp-jump-nav {
    display: none;
  }

  /* Wraps the page's second "movement" (Business Transactions and Finance
     through Appeals) in a quiet background shift — a pacing device for six
     otherwise-identical sections in a row, not a second consultation-style
     band, which would wrongly imply a decision point mid-page. Spans the
     full width of .exp-main's own grid column (not just the narrow
     centered reading measure each section uses), so the color genuinely
     reads as "the page changed" rather than a floating box with
     unexplained gutters on either side — the inner .exp-section elements
     keep their own centering/padding untouched. --bg-raised keeps a full
     step below --bg-raised-2, which .exp-compare already uses for the
     client-type/proof metadata box nested inside each section — if both
     used the same token, the metadata box would lose its own contrast and
     disappear into this new parent background. */
  .exp-movement {
    width: 100%;
    background: var(--bg-raised);
  }

  /* Portrait-tablet and mobile (<=1099px, matching About's own rail
     breakpoint): sticky labeled jump control — the same pattern as
     About's .about-jump-nav, reused verbatim including its placement
     before the intro, so the nav is available immediately rather than
     appearing mid-scroll. */
  @media (max-width: 1099px) {
    .exp-jump-nav {
      display: block;
      /* No bottom margin — the intro's own top padding provides the gap
         below it; a margin here would stack on top of that and double the
         space. */
      margin: var(--s5) var(--s4) 0;
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: var(--s3) var(--s4);
      position: sticky;
      top: calc(var(--s4) + 60px);
      background: var(--bg);
      z-index: 10;
    }

    .exp-jump-nav summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s3);
      cursor: pointer;
      font-weight: 700;
    }

    /* Explicit chevron, identical across browsers — see global.css for why
       the native ::marker/::-webkit-details-marker is hidden instead of
       left to render differently per browser. A real inline SVG rather than
       a border-drawn ::after: the border-corner trick draws ink into only
       two of its box's four edges, so the visible mark sits off-center
       within its own box and needs a manual pixel correction to look
       centered — one that (on this element specifically) was visibly
       snapping into place a frame after page load. An SVG's mark is already
       centered in its own viewBox, so `align-items: center` on the flex
       parent centers it correctly with nothing to nudge or catch up. */
    .exp-jump-nav .jump-nav-chevron {
      flex-shrink: 0;
      transition: transform var(--transition-fast);
    }

    .exp-jump-nav[open] .jump-nav-chevron {
      transform: rotate(180deg);
    }

    .exp-jump-nav ul {
      list-style: none;
      margin: var(--s3) 0 0;
      padding: 0;
    }

    .exp-jump-nav li a {
      display: flex;
      align-items: center;
      min-height: 44px;
      color: var(--fg);
    }

    .exp-jump-nav li a.is-active {
      color: var(--navy);
      text-shadow: 0.2px 0 currentColor, -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .exp-jump-nav li a.is-active {
      color: var(--gold-accent);
    }

    /* Page header: matches the same eyebrow/h1 centering used on Home,
       About, and Contact once their two-column/rail layouts collapse. The
       intro's lead and "ask Russ" link are short enough to center along
       with it, same as Home's hero and Contact's hero. Matching section
       -level centering (the .exp-section__rule mark + h2) lives with
       ExpertiseSection.astro, alongside the elements it centers. */
    .exp-intro {
      text-align: center;
    }
  }

  /* Wide (>=1100px): persistent side index. */
  @media (min-width: 1100px) {
    /* No grid gap: with .exp-movement's background now spanning this whole
       column (see below), a gap here would leave an untinted sliver of
       page background between the sidebar's rule and the tinted area —
       the color needs to start right at the sidebar to read as confident
       rather than accidental. The sidebar's own padding-right (var(--s5))
       plus each section's padding-left (var(--s6), set in
       ExpertiseSection.astro) still keeps real breathing room either
       side of the divider — this was previously stacking on top of the
       gap removed here, not the only source of it. */
    .exp-layout {
      grid-template-columns: 230px 1fr;
    }

    .exp-index {
      display: block;
      position: sticky;
      top: calc(var(--s8) + 60px);
      align-self: start;
      padding: var(--s6) var(--s5) var(--s6) 0;
      border-right: 1px solid var(--rule);
      max-height: calc(100vh - var(--s8) - 60px);
      overflow-y: auto;
    }

    .exp-index ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .exp-index li {
      border-bottom: 1px solid var(--rule);
    }

    .exp-index a {
      display: block;
      padding: var(--s3) 0 var(--s3) var(--s3);
      border-left: 2px solid transparent;
      color: var(--fg-soft);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9375rem;
    }

    .exp-index a:hover,
    .exp-index a:focus-visible {
      color: var(--fg);
    }

    .exp-index a.is-active {
      border-left-color: var(--gold-accent);
      color: var(--navy);
      text-shadow: 0.2px 0 currentColor, -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .exp-index a.is-active {
      color: var(--fg);
    }

    /* .exp-intro has max-width: none (spans the full column, no narrow
       centered box), unlike .exp-section which keeps page-section--narrow's
       auto-centering margin — that margin was quietly doing most of the
       sections' own left-offset from the sidebar, so removing the grid gap
       above barely touched them. Intro had no such margin, so it needs to
       recover the removed gap directly in its own padding instead of just
       .exp-section's smaller var(--s6) inset. Right padding matches left:
       intro spans edge-to-edge with no centering to fall back on, so unlike
       the auto-centered sections, uneven padding here is immediately
       visible as lopsided rather than just slightly-more-whitespace. */
    .exp-intro {
      padding-left: calc(var(--s6) + var(--s7));
      padding-right: calc(var(--s6) + var(--s7));
      max-width: none;
    }
  }
</style>
