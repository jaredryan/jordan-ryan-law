---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ContactForm from '@/components/ContactForm.astro'
import { contact, address } from '@/data/site'
import { russRyan, crystalBrightwell } from '@/data/people'
import { webPageJsonLd } from '@/lib/json-ld'

const description = 'How to get in touch with Ryan Legal, PC: phone, address, email, or request a consultation through our website.'
const keywords = [
  'Contact Ryan Legal PC',
  'Schedule Legal Consultation',
  'Employment Lawyer Consultation',
  'Business Attorney Contact',
  'Legal Services California',
  'Legal Services Utah',
]

const jsonLd = [
  webPageJsonLd({
    path: '/contact',
    name: 'Contact Ryan Legal, PC',
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Contact Us', path: '/contact' },
    ],
  }),
]

const fullAddress = `${address.street}, ${address.suite}, ${address.city}, ${address.state} ${address.postalCode}`
---

<BaseLayout title="Contact Us" description={description} path="/contact" keywords={keywords} jsonLd={jsonLd}>
  <section class="page-section page-section--narrow contact-hero">
    <span class="eyebrow">Get in touch</span>
    <h1>Start with a conversation</h1>
  </section>

  <section class="page-section contact-main">
    <div class="contact-main__info">
      <div class="contact-primary-card">
        <a href={`tel:${contact.phoneHref}`} class="contact-primary-card__phone">{contact.phoneDisplay}</a>
      </div>

      <ul class="contact-people">
        <li class="contact-person">
          <p class="contact-person__name">{russRyan.alternateName} Ryan</p>
          <p class="contact-person__role">Attorney</p>
          <a href={`mailto:${contact.emails.russ}`}>{contact.emails.russ}</a>
        </li>
        <li class="contact-person">
          <p class="contact-person__name">{crystalBrightwell.name}</p>
          <p class="contact-person__role">{crystalBrightwell.workingTitle}</p>
          <a href={`mailto:${contact.emails.crystal}`}>{contact.emails.crystal}</a>
        </li>
      </ul>

      <p class="contact-roles">
        {russRyan.alternateName} is the sole attorney at the firm. {crystalBrightwell.name} can help answer questions
        about scheduling and paperwork, and can help arrange a conversation with {russRyan.alternateName} — she does
        not provide legal advice, and contacting the office does not by itself create an attorney-client relationship.
      </p>

      <div class="contact-office">
        <span class="eyebrow">Office</span>
        <a
          href={address.googleMapsDirectionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link-editorial"
          aria-label={`Open Ryan Legal's office in Google Maps: ${fullAddress}`}
        >
          {fullAddress}
        </a>
      </div>
    </div>

    <div class="contact-main__form">
      <h2>Request a Consultation</h2>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-bottom: var(--s4);
  }

  .contact-main {
    display: grid;
    grid-template-columns: minmax(280px, 380px) 1fr;
    gap: var(--s8);
    align-items: start;
    padding-top: var(--s4);
  }

  .contact-primary-card {
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--gold-accent);
    border-radius: 4px;
    padding: var(--s5) var(--s6);
    margin-bottom: var(--s5);
  }

  .contact-primary-card__phone {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    text-decoration: none;
    color: var(--fg);
  }

  .contact-primary-card__phone:hover,
  .contact-primary-card__phone:focus-visible {
    color: var(--navy);
  }

  :root[data-theme='dark'] .contact-primary-card__phone:hover,
  :root[data-theme='dark'] .contact-primary-card__phone:focus-visible {
    color: var(--gold-accent);
  }

  .contact-people {
    list-style: none;
    margin: 0 0 var(--s6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s5);
  }

  .contact-person {
    border-top: 1px solid var(--rule);
    padding-top: var(--s3);
  }

  .contact-person__name {
    font-weight: 700;
    margin: 0;
  }

  .contact-person__role {
    color: var(--fg-soft);
    font-size: 0.875rem;
    margin: 0 0 var(--s1);
  }

  .contact-person a {
    color: var(--fg-soft);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-person a:hover,
  .contact-person a:focus-visible {
    color: var(--navy);
  }

  :root[data-theme='dark'] .contact-person a:hover,
  :root[data-theme='dark'] .contact-person a:focus-visible {
    color: var(--gold-accent);
  }

  .contact-roles {
    color: var(--fg-soft);
    font-size: 0.9375rem;
  }

  .contact-office {
    margin-top: var(--s6);
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
  }

  .contact-office .eyebrow {
    margin-bottom: var(--s2);
  }

  .contact-main__form h2 {
    margin-top: 0;
  }

  @media (max-width: 899px) {
    .contact-main {
      grid-template-columns: 1fr;
      gap: var(--s7);
    }
  }
</style>
