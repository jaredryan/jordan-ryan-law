---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ContactForm from '@/components/ContactForm.astro'
import { contact, address, businessName } from '@/data/site'
import { jordanRyan } from '@/data/people'
import { webPageJsonLd, jordanRyanId } from '@/lib/json-ld'

const description = `How to get in touch with ${businessName}: phone, address, email, or request a consultation through our website.`
const keywords = [
  'Contact Jordan Ryan Law',
  'Schedule Legal Consultation',
  'Commercial Real Estate Attorney Contact',
  'Legal Services Texas',
]

const jsonLd = [
  webPageJsonLd({
    path: '/contact',
    name: `Contact ${businessName}`,
    description,
    // "Contact" matches the nav label — /contact-us is only a 301 redirect,
    // never the client-facing name for this page.
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ],
    pageType: 'ContactPage',
    mentions: [{ '@id': jordanRyanId }],
  }),
]

const fullAddress = `${address.street}, ${address.suite}, ${address.city}, ${address.state} ${address.postalCode}`
---

<BaseLayout title="Contact Us" description={description} path="/contact" keywords={keywords} jsonLd={jsonLd}>
  <section class="page-section page-section--narrow contact-hero page-hero">
    <span class="eyebrow">Contact</span>
    <h1>Discuss your legal needs</h1>
    <p class="lead">Contact Jordan Ryan Law regarding commercial real estate, business transactions, or other legal matters.</p>
  </section>

  <section class="page-section contact-main">
    <div class="contact-main__info">
      <span class="eyebrow">Reach us directly</span>
      <ul class="contact-info-list">
        <li class="contact-block">
          <p class="contact-block__title">{jordanRyan.alternateName} Ryan</p>
          <p class="contact-block__meta">Attorney</p>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li class="contact-block">
          <p class="contact-block__title">Phone</p>
          <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
        </li>
        <li class="contact-block">
          <p class="contact-block__title">Office</p>
          <a
            href={address.googleMapsDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${businessName}'s office in Google Maps: ${fullAddress}`}
          >
            {fullAddress}
          </a>
        </li>
      </ul>
    </div>

    <div class="contact-main__form">
      <h2>Send a message</h2>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-bottom: var(--s4);
  }

  .contact-main {
    display: grid;
    grid-template-columns: minmax(280px, 380px) minmax(280px, 560px);
    gap: var(--s8);
    align-items: start;
    padding-top: var(--s4);
    /* The two columns' own natural widths (info column up to 380px, form
       column up to the .contact-form max-width of 560px) plus the gap
       between them — capping the combined unit here and centering it
       treats info+form as one composition within the page rather than
       letting the form column stretch to fill whatever space is left,
       which is what pushed the info column against the left edge with a
       lot of empty space to the right of the form. */
    max-width: calc(380px + var(--s8) + 560px);
    margin: 0 auto;
  }

  /* Restrained brand treatment for the direct-contact column: a raised,
     warm-tinted panel with a stone top edge — kept to this one column so
     the form panel beside it stays plain and task-focused. */
  .contact-main__info {
    background: var(--surface);
    border-radius: 4px;
    border-top: 3px solid var(--stone);
    padding: var(--s6);
  }

  .contact-info-list {
    list-style: none;
    margin: 0 0 var(--s6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s5);
  }

  .contact-info-list:last-child {
    margin-bottom: 0;
  }

  .contact-block {
    border-top: 1px solid var(--border);
    padding-top: var(--s3);
  }

  /* Inside the new panel, the eyebrow above already separates the list from
     the panel edge — a second rule directly under it on the first item
     would read as a doubled divider. */
  .contact-info-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .contact-block__title {
    font-weight: 700;
    margin: 0;
  }

  .contact-block__meta {
    color: var(--muted-text);
    font-size: 0.875rem;
    margin: 0 0 var(--s1);
  }

  .contact-block a {
    color: var(--muted-text);
    text-decoration: none;
    font-weight: 600;
    word-break: break-word;
  }

  .contact-block a:hover,
  .contact-block a:focus-visible {
    color: var(--navy);
  }

  :root[data-theme='dark'] .contact-block a:hover,
  :root[data-theme='dark'] .contact-block a:focus-visible {
    color: var(--stone);
  }

  .contact-main__form h2 {
    margin-top: 0;
    margin-bottom: var(--s5);
    font-family: var(--font-body);
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 700;
  }

  @media (max-width: 899px) {
    .contact-main {
      grid-template-columns: 1fr;
      gap: var(--s7);
    }

    /* At single-column widths the form container itself is centered as a
       block — matching Payment's contained, balanced feel — while its own
       fields, labels, and entered text (unaffected by this, since it
       targets the wrapper and heading only) stay left aligned. */
    .contact-main__form {
      max-width: 560px;
      margin: 0 auto;
    }

    .contact-main__form h2 {
      text-align: center;
    }

    /* The submit button isn't a direct flex child of .contact-form (it's
       nested one div deeper, alongside the status message), so align-self
       has no effect on it — centering it as a block instead. */
    .contact-main__form :global(.contact-form button[type='submit']) {
      display: flex;
      margin: 0 auto;
    }
  }
</style>
