---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ContactForm from '@/components/ContactForm.astro'
import { contact, address } from '@/data/site'
import { russRyan, crystalBrightwell } from '@/data/people'
import { webPageJsonLd, russRyanId, crystalBrightwellId } from '@/lib/json-ld'

const description = 'How to get in touch with Ryan Legal, PC: phone, address, email, or request a consultation through our website.'
const keywords = [
  'Contact Ryan Legal PC',
  'Schedule Legal Consultation',
  'Employment Lawyer Consultation',
  'Business Attorney Contact',
  'Legal Services California',
  'Legal Services Utah',
]

const jsonLd = [
  webPageJsonLd({
    path: '/contact',
    name: 'Contact Ryan Legal, PC',
    description,
    // "Contact" matches the nav label — /contact-us is only a 301 redirect,
    // never the client-facing name for this page.
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'Contact', path: '/contact' },
    ],
    pageType: 'ContactPage',
    mentions: [{ '@id': russRyanId }, { '@id': crystalBrightwellId }],
  }),
]

const fullAddress = `${address.street}, ${address.suite}, ${address.city}, ${address.state} ${address.postalCode}`
---

<BaseLayout title="Contact Us" description={description} path="/contact" keywords={keywords} jsonLd={jsonLd}>
  <section class="page-section page-section--narrow contact-hero">
    <span class="eyebrow">Get in touch</span>
    <h1>Start a conversation</h1>
    <p class="lead">Reach Russ or Crystal directly, or use the form to send a message.</p>
  </section>

  <section class="page-section contact-main">
    <div class="contact-main__info">
      <span class="eyebrow">Reach us directly</span>
      <ul class="contact-info-list">
        <li class="contact-block">
          <p class="contact-block__title">{russRyan.alternateName} Ryan</p>
          <p class="contact-block__meta">Attorney</p>
          <a href={`mailto:${contact.emails.russ}`}>{contact.emails.russ}</a>
        </li>
        <li class="contact-block">
          <p class="contact-block__title">{crystalBrightwell.name}</p>
          <p class="contact-block__meta">{crystalBrightwell.workingTitle}</p>
          <a href={`mailto:${contact.emails.crystal}`}>{contact.emails.crystal}</a>
        </li>
        <li class="contact-block">
          <p class="contact-block__title">Phone</p>
          <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
        </li>
        <li class="contact-block">
          <p class="contact-block__title">Office</p>
          <a
            href={address.googleMapsDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open Ryan Legal's office in Google Maps: ${fullAddress}`}
          >
            {fullAddress}
          </a>
        </li>
      </ul>
    </div>

    <div class="contact-main__form">
      <h2>Send a message</h2>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-bottom: var(--s4);
  }

  .contact-main {
    display: grid;
    grid-template-columns: minmax(280px, 380px) 1fr;
    gap: var(--s8);
    align-items: start;
    padding-top: var(--s4);
  }

  /* Restrained brand treatment for the direct-contact column: a raised,
     warm-tinted panel with a gold top edge — the same "gold marks an
     opening" language used for Expertise's chapter numbers — kept to this
     one column so the form panel beside it stays plain and task-focused. */
  .contact-main__info {
    background: var(--bg-raised-2);
    border-radius: 4px;
    border-top: 3px solid var(--gold-accent);
    padding: var(--s6);
  }

  .contact-info-list {
    list-style: none;
    margin: 0 0 var(--s6);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s5);
  }

  .contact-info-list:last-child {
    margin-bottom: 0;
  }

  .contact-block {
    border-top: 1px solid var(--rule);
    padding-top: var(--s3);
  }

  /* Inside the new panel, the eyebrow above already separates the list from
     the panel edge — a second rule directly under it on the first item
     would read as a doubled divider. */
  .contact-info-list li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .contact-block__title {
    font-weight: 700;
    margin: 0;
  }

  .contact-block__meta {
    color: var(--fg-soft);
    font-size: 0.875rem;
    margin: 0 0 var(--s1);
  }

  .contact-block a {
    color: var(--fg-soft);
    text-decoration: none;
    font-weight: 600;
    word-break: break-word;
  }

  .contact-block a:hover,
  .contact-block a:focus-visible {
    color: var(--navy);
  }

  :root[data-theme='dark'] .contact-block a:hover,
  :root[data-theme='dark'] .contact-block a:focus-visible {
    color: var(--gold-accent);
  }

  .contact-main__form h2 {
    margin-top: 0;
    margin-bottom: var(--s5);
    font-family: var(--font-body);
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 700;
  }

  @media (max-width: 899px) {
    .contact-main {
      grid-template-columns: 1fr;
      gap: var(--s7);
    }
  }
</style>
