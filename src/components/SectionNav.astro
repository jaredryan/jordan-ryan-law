---
// Scroll-spy section nav, currently used by About only: a sticky rail at
// desktop widths, a collapsible jump-nav at narrow/tablet widths — never
// both at once (src/scripts/scroll-spy.ts drives both via [data-spy-rail]).
interface Props {
  items: { id: string; name: string }[]
  railLabel: string
  jumpLabel: string
}

const { items, railLabel, jumpLabel } = Astro.props
---

<aside class="section-nav-rail" aria-label={railLabel} data-spy-rail>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.name}</a>
        </li>
      ))
    }
  </ol>
</aside>

<details class="jump-nav" data-spy-rail>
  <summary>
    {jumpLabel}
    <svg class="jump-nav-chevron" width="16" height="16" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path
        d="M2.5 4.5L6 8L9.5 4.5"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </summary>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.name}</a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .section-nav-rail {
    display: none;
  }

  .jump-nav {
    display: none;
  }

  @media (max-width: 1099px) {
    .jump-nav {
      /* No bottom margin — the page's own intro top padding provides the
         gap below it; a margin here would stack on top of that. */
      margin: var(--s5) var(--s4) 0;
      display: block;
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: var(--s3) var(--s4);
      position: sticky;
      top: calc(var(--s4) + 60px);
      background: var(--background);
      z-index: 10;
    }

    .jump-nav summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s3);
      cursor: pointer;
      font-weight: 700;
    }

    /* Explicit chevron, identical across browsers — see global.css for why
       the native ::marker/::-webkit-details-marker is hidden instead of
       left to render differently per browser. */
    .jump-nav .jump-nav-chevron {
      flex-shrink: 0;
      transition: transform var(--transition-fast);
    }

    .jump-nav[open] .jump-nav-chevron {
      transform: rotate(180deg);
    }

    .jump-nav ul {
      list-style: none;
      margin: var(--s3) 0 0;
      padding: 0;
    }

    .jump-nav li a {
      display: flex;
      align-items: center;
      min-height: 44px;
      color: var(--text);
    }

    .jump-nav li a:hover,
    .jump-nav li a:focus-visible {
      color: var(--accent);
    }

    .jump-nav li a.is-active {
      color: var(--navy);
      text-shadow:
        0.2px 0 currentColor,
        -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .jump-nav li a.is-active {
      color: var(--stone);
    }
  }

  @media (min-width: 1100px) {
    .section-nav-rail {
      display: block;
      position: sticky;
      top: calc(var(--s8) + 60px);
      align-self: start;
      border-right: 1px solid var(--border);
      max-height: calc(100vh - var(--s8) - 60px);
      overflow-y: auto;
      padding: var(--s6) var(--s4) var(--s6) 0;
    }

    .section-nav-rail ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .section-nav-rail a {
      display: block;
      border-left: 2px solid transparent;
      color: var(--muted-text);
      text-decoration: none;
      font-weight: 600;
      padding: var(--s2) 0 var(--s2) var(--s3);
      font-size: 0.875rem;
    }

    .section-nav-rail a:hover,
    .section-nav-rail a:focus-visible {
      color: var(--accent);
    }

    .section-nav-rail a.is-active {
      border-left-color: var(--stone);
      color: var(--navy);
      text-shadow:
        0.2px 0 currentColor,
        -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .section-nav-rail a.is-active {
      color: var(--text);
    }
  }
</style>
