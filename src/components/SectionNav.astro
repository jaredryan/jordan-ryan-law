---
// Scroll-spy section nav shared by About and Expertise: a sticky rail at
// desktop widths, a collapsible jump-nav at narrow/tablet widths — never
// both at once (src/scripts/scroll-spy.ts drives both via [data-spy-rail]).
//
// `density` covers the one real difference between the two pages' desktop
// rails: About lists 8 categorical sections at a tighter size with no row
// dividers; Expertise lists 6 practice areas with more generous padding and
// a divider between each. Same variant-prop pattern as ThemeToggle.astro.
interface Props {
  items: { id: string; name: string }[]
  railLabel: string
  jumpLabel: string
  density: 'compact' | 'roomy'
}

const { items, railLabel, jumpLabel, density } = Astro.props
---

<aside class:list={['section-nav-rail', `section-nav-rail--${density}`]} aria-label={railLabel} data-spy-rail>
  <ol>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.name}</a>
        </li>
      ))
    }
  </ol>
</aside>

<details class="jump-nav" data-spy-rail>
  <summary>
    {jumpLabel}
    <svg class="jump-nav-chevron" width="16" height="16" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`}>{item.name}</a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .section-nav-rail {
    display: none;
  }

  .jump-nav {
    display: none;
  }

  @media (max-width: 1099px) {
    .jump-nav {
      /* No bottom margin — the page's own intro top padding provides the
         gap below it; a margin here would stack on top of that. */
      margin: var(--s5) var(--s4) 0;
      display: block;
      border: 1px solid var(--rule);
      border-radius: 4px;
      padding: var(--s3) var(--s4);
      position: sticky;
      top: calc(var(--s4) + 60px);
      background: var(--bg);
      z-index: 10;
    }

    .jump-nav summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s3);
      cursor: pointer;
      font-weight: 700;
    }

    /* Explicit chevron, identical across browsers — see global.css for why
       the native ::marker/::-webkit-details-marker is hidden instead of
       left to render differently per browser. */
    .jump-nav .jump-nav-chevron {
      flex-shrink: 0;
      transition: transform var(--transition-fast);
    }

    .jump-nav[open] .jump-nav-chevron {
      transform: rotate(180deg);
    }

    .jump-nav ul {
      list-style: none;
      margin: var(--s3) 0 0;
      padding: 0;
    }

    .jump-nav li a {
      display: flex;
      align-items: center;
      min-height: 44px;
      color: var(--fg);
    }

    .jump-nav li a.is-active {
      color: var(--navy);
      text-shadow:
        0.2px 0 currentColor,
        -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .jump-nav li a.is-active {
      color: var(--gold-accent);
    }
  }

  @media (min-width: 1100px) {
    .section-nav-rail {
      display: block;
      position: sticky;
      top: calc(var(--s8) + 60px);
      align-self: start;
      border-right: 1px solid var(--rule);
      max-height: calc(100vh - var(--s8) - 60px);
      overflow-y: auto;
    }

    .section-nav-rail ol {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .section-nav-rail a {
      display: block;
      border-left: 2px solid transparent;
      color: var(--fg-soft);
      text-decoration: none;
      font-weight: 600;
    }

    .section-nav-rail a:hover,
    .section-nav-rail a:focus-visible {
      color: var(--fg);
    }

    .section-nav-rail a.is-active {
      border-left-color: var(--gold-accent);
      color: var(--navy);
      text-shadow:
        0.2px 0 currentColor,
        -0.2px 0 currentColor;
    }

    :root[data-theme='dark'] .section-nav-rail a.is-active {
      color: var(--fg);
    }

    /* About: 8 categorical sections — tighter padding/type, no row dividers. */
    .section-nav-rail--compact {
      padding: var(--s6) var(--s4) var(--s6) 0;
    }

    .section-nav-rail--compact a {
      padding: var(--s2) 0 var(--s2) var(--s3);
      font-size: 0.875rem;
    }

    /* Expertise: 6 practice areas — roomier padding/type, ruled rows. */
    .section-nav-rail--roomy {
      padding: var(--s6) var(--s5) var(--s6) 0;
    }

    .section-nav-rail--roomy li {
      border-bottom: 1px solid var(--rule);
    }

    .section-nav-rail--roomy a {
      padding: var(--s3) 0 var(--s3) var(--s3);
      font-size: 0.9375rem;
    }
  }
</style>
