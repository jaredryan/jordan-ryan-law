---
import { businessName, navLinks } from '@/data/site'

const currentPath = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
---

<header class="site-header">
  <div class="site-header__bar">
    <a href="/" class="site-header__brand" aria-label={`${businessName} home`}>
      <img src="/icon.svg" alt="" width="32" height="32" />
      <span>{businessName}</span>
    </a>

    <button
      type="button"
      class="site-header__menu-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span aria-hidden="true">☰</span>
    </button>

    <nav aria-label="Primary" class="site-header__nav" id="primary-nav" data-menu>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script src="@/scripts/menu.ts"></script>
