---
import { businessName, navLinks, contact } from '@/data/site'
import ThemeToggle from '@/components/ThemeToggle.astro'

const currentPath = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
---

<header class="site-header on-navy">
  <div class="site-header__bar">
    <a href="/" class="site-header__brand">
      <img src="/logo-white.webp" alt="" width="37" height="27" class="site-header__brand-mark" />
      <span class="site-header__brand-divider" aria-hidden="true"></span>
      <span class="site-header__brand-name">{businessName}</span>
    </a>

    <nav aria-label="Primary" class="site-header__nav">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={`tel:${contact.phoneHref}`} class="site-header__phone">{contact.phoneDisplay}</a>
      <ThemeToggle variant="compact" />
      <a href="/contact/" class="btn btn-primary site-header__cta">
        <span class="site-header__cta-full">Schedule a Consultation</span>
        <span class="site-header__cta-short">Consultation</span>
      </a>
    </div>

    <button
      type="button"
      class="site-header__menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>

  <div class="site-header__drawer-backdrop" data-menu-backdrop></div>

  <div
    id="mobile-nav"
    class="site-header__drawer on-navy"
    data-menu
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    inert
  >
    <div class="site-header__drawer-top">
      <a href="/" class="site-header__drawer-brand" aria-label={`${businessName} — Home`}>
        <img src="/logo-white.webp" alt="" width="32" height="23" class="site-header__drawer-brand-mark" />
      </a>
      <button type="button" class="site-header__drawer-close" data-menu-close>
        <span class="sr-only">Close menu</span>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Primary" class="site-header__drawer-nav">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contact/" class="btn btn-primary site-header__drawer-cta">Schedule a Consultation</a>

    <div class="site-header__drawer-appearance">
      <ThemeToggle variant="labeled" />
    </div>

    <span class="site-header__drawer-divider" aria-hidden="true"></span>

    <img
      src="/footer-logo-white-300.webp"
      alt={businessName}
      width="300"
      height="287"
      class="site-header__drawer-logo"
    />
  </div>
</header>

<script src="@/scripts/menu.ts"></script>
<script src="@/scripts/theme.ts"></script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-footer-bg);
    color: var(--nav-footer-text);
  }

  .site-header__bar {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s4) var(--s5);
    display: flex;
    align-items: center;
    gap: var(--s6);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--s3);
    color: #fff;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__brand-mark {
    display: block;
    flex-shrink: 0;
  }

  .site-header__brand-divider {
    display: block;
    width: 1px;
    height: 24px;
    background: var(--nav-footer-rule);
  }

  .site-header__brand-name {
    font-family: var(--font-display);
    /* Lighter than the rest of the site's uppercase utility weights — next
       to the JR monogram's thin strokes, 700 read chunky at this size. */
    font-weight: 200;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
    line-height: 1.05;
    white-space: nowrap;
  }

  @media (max-width: 400px) {
    .site-header__brand-name {
      font-size: 1.125rem;
    }
  }

  .site-header__nav {
    flex: 1;
    min-width: 0;
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--s5);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .site-header__nav a {
    display: inline-block;
    position: relative;
    padding: 0.35rem 0.1rem;
    color: var(--nav-footer-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  /* Corner-bracket motif (see .bracket-frame in global.css) instead of a
     text color change: hover/focus shows it in accent blue, faded in via
     opacity so it never affects layout. */
  .site-header__nav a::before,
  .site-header__nav a::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .site-header__nav a::before {
    top: -4px;
    left: -8px;
    border-top: 2px solid var(--accent-on-navy);
    border-left: 2px solid var(--accent-on-navy);
  }

  .site-header__nav a::after {
    bottom: -4px;
    right: -8px;
    border-bottom: 2px solid var(--accent-on-navy);
    border-right: 2px solid var(--accent-on-navy);
  }

  .site-header__nav a:hover::before,
  .site-header__nav a:hover::after,
  .site-header__nav a:focus-visible::before,
  .site-header__nav a:focus-visible::after {
    opacity: 1;
  }

  /* Active link: same bracket geometry, always visible, in stone — and
     ordered after the hover/focus rules above so it wins the tie (equal
     specificity) when the current page's own link is hovered, keeping the
     brackets stone instead of switching to the blue hover treatment. */
  .site-header__nav a[aria-current='page']::before,
  .site-header__nav a[aria-current='page']::after {
    opacity: 1;
    border-color: var(--stone);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-shrink: 0;
  }

  .site-header__phone {
    color: var(--nav-footer-text-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .site-header__phone:hover,
  .site-header__phone:focus-visible {
    color: var(--accent-on-navy);
  }

  .site-header__cta-short {
    display: none;
  }

  .site-header__menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 1px solid var(--nav-footer-rule);
    color: #fff;
    border-radius: 4px;
    padding: var(--s2) var(--s3);
    cursor: pointer;
  }

  .site-header__menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }

  .site-header__menu-icon span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  /* Wide desktop and laptop (>=1300px): full treatment, phone shown. */
  @media (min-width: 1300px) {
    .site-header__bar {
      gap: var(--s7);
    }
  }

  /* Condensed landscape-tablet / narrow-laptop (900–1299px):
     reduced spacing, no phone, shortened CTA, all five destinations stay
     visible without wrapping or colliding. */
  @media (max-width: 1299px) {
    .site-header__phone {
      display: none;
    }

    .site-header__bar {
      gap: var(--s4);
      padding: var(--s3) var(--s4);
    }

    .site-header__nav ul {
      gap: var(--s4);
    }

    .site-header__cta-full {
      display: none;
    }

    .site-header__cta-short {
      display: inline;
    }

    .site-header__cta {
      padding: 0.7rem 1rem;
    }
  }

  /* Portrait-tablet and mobile (<900px): drawer-nav toggle button shown. */
  @media (max-width: 899px) {
    .site-header__nav,
    .site-header__actions {
      display: none;
    }

    .site-header__menu-toggle {
      display: inline-flex;
      margin-left: auto;
    }
  }

  /* Mobile/tablet drawer — replaces the old full-width expanded disclosure
     menu. Positioning is unconditional (not gated to <900px): the toggle
     that opens it only exists below 900px, and `inert` (toggled in
     menu.ts) keeps it out of the tab order and accessibility tree whenever
     it's closed, so there's no need to also fight it out of the layout
     with a breakpoint — one fewer place for the two to drift out of sync. */
  .site-header__drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 20, 32, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
    z-index: 60;
  }

  .site-header__drawer-backdrop[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  .site-header__drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(300px, 85vw);
    display: flex;
    flex-direction: column;
    background: var(--nav-footer-bg);
    color: var(--nav-footer-text);
    padding: var(--s5);
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.25);
    overflow-y: auto;
    transform: translateX(100%);
    visibility: hidden;
    /* visibility flips to hidden only after the slide-out finishes (matches
       the transform duration) — keeps it out of the accessibility tree and
       out of visibility-based automated checks while closed, without losing
       the animated slide (display:none can't be transitioned). */
    transition:
      transform 0.25s ease,
      visibility 0s linear 0.25s;
    z-index: 61;
  }

  .site-header__drawer[data-open] {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.25s ease;
  }

  .site-header__drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s4);
  }

  .site-header__drawer-brand {
    display: flex;
    align-items: center;
    gap: var(--s3);
    color: #fff;
    text-decoration: none;
    min-width: 0;
  }

  .site-header__drawer-brand-mark {
    display: block;
    flex-shrink: 0;
  }

  .site-header__drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 1px solid var(--nav-footer-rule);
    color: #fff;
    border-radius: 4px;
  }

  .site-header__drawer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .site-header__drawer-nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: var(--s3) 0;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
    border-bottom: 1px solid var(--nav-footer-rule);
  }

  .site-header__drawer-nav a:hover,
  .site-header__drawer-nav a:focus-visible {
    color: var(--accent-on-navy);
  }

  /* Ordered after :hover/:focus-visible so the current page's link stays
     stone even when hovered, instead of switching to the blue interaction
     state (same specificity — later wins). */
  .site-header__drawer-nav a[aria-current='page'] {
    color: var(--stone);
  }

  .site-header__drawer-cta {
    width: 100%;
    margin-top: var(--s5);
  }

  .site-header__drawer-divider {
    display: block;
    height: 1px;
    background: var(--nav-footer-rule);
    margin: var(--s6) 0 var(--s5);
  }

  /* The drawer's main branding moment — the full logo (mark + firm name),
     sized comfortably rather than filling the drawer's width, and centered
     since nothing else in the drawer shares a left edge with it. */
  .site-header__drawer-logo {
    display: block;
    width: 168px;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .site-header__drawer-appearance {
    margin-top: var(--s5);
  }

  /* Legacy phones with very short viewports (e.g. iPhone SE in landscape,
     older Android devices) can't fit the full-height drawer content above
     the fold — drop the trailing brand moment (divider + logo) first since
     it's decorative, not navigational. */
  @media (max-height: 659px) {
    .site-header__drawer-divider,
    .site-header__drawer-logo {
      display: none;
    }
  }
</style>
