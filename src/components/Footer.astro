---
import { businessName, navLinks, contact, address } from '@/data/site'

interface Props {
  // Removes the footer's top margin so it sits flush against whatever
  // navy/dark surface precedes it (e.g. Home's consultation band, 404's
  // compact content). Ordinary pages keep the default spaced margin.
  flush?: boolean
}

const { flush = false } = Astro.props
const year = new Date().getFullYear()
---

<footer class:list={['site-footer', 'on-navy', { 'site-footer--flush': flush }]}>
  <div class="site-footer__bar">
    <div class="site-footer__brand-block">
      <a href="/" class="site-footer__brand" aria-label={`${businessName} — Home`}>
        <img src="/footer-logo-white-300.webp" alt="" width="150" height="144" class="site-footer__brand-mark" />
      </a>
      <address class="site-footer__address">
        {address.street}, {address.suite}<br />
        {address.city}, {address.state}
        {address.postalCode}
      </address>
    </div>

    <nav aria-label="Footer">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__contact">
      <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href="/contact" class="btn btn-secondary site-footer__cta">Schedule a Consultation</a>
    </div>
  </div>
  <p class="site-footer__copyright">
    &copy; {year} {businessName}, a Professional Limited Liability Company. All Rights Reserved. <a
      href="/privacy"
      class="site-footer__legal-link">Privacy Policy</a
    >
  </p>
</footer>

<style>
  .site-footer {
    background: var(--surface-navy);
    color: var(--surface-navy-fg);
    /* Pages without their own navy/dark closing band (Contact) —
       tighter than --s9 so the page doesn't end with noticeably more
       breathing room than it opened with under the header. Pages that do
       end in a closing band keep that band's own deliberate padding via
       .site-footer--flush below, untouched. */
    margin-top: var(--s7);
  }

  .site-footer--flush {
    margin-top: 0;
  }

  .site-footer__bar {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s7) var(--s5);
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: var(--s7);
    /* Each column's content group is centered within its own track rather
       than stretching to the track's full width and sitting flush left —
       the brand block, nav list, and contact block each keep their own
       internal left alignment (address lines, nav links, contact details
       all still line up against each other), only the group as a whole
       shifts to the middle of its column. */
    justify-items: center;
  }

  .site-footer__brand {
    display: inline-block;
    margin-bottom: var(--s5);
  }

  .site-footer__brand-mark {
    display: block;
    width: 150px;
    max-width: 100%;
    height: auto;
  }

  .site-footer__address {
    font-style: normal;
    color: var(--surface-navy-fg-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .site-footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .site-footer nav a {
    color: var(--surface-navy-fg-soft);
    text-decoration: none;
    font-weight: 600;
  }

  .site-footer nav a:hover,
  .site-footer nav a:focus-visible {
    color: #fff;
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
  }

  .site-footer__contact a:not(.btn) {
    color: var(--surface-navy-fg-soft);
    text-decoration: none;
    font-weight: 600;
  }

  .site-footer__contact a:not(.btn):hover,
  .site-footer__contact a:not(.btn):focus-visible {
    color: #fff;
  }

  .site-footer__cta {
    margin-top: var(--s2);
  }

  .site-footer__copyright {
    text-align: center;
    padding: var(--s5) var(--s5) var(--s6);
    margin: 0;
    font-size: 0.8125rem;
    color: var(--surface-navy-fg-soft);
    border-top: 1px solid var(--surface-navy-rule);
  }

  .site-footer__legal-link {
    color: var(--surface-navy-fg-soft);
    text-decoration: underline;
  }

  .site-footer__legal-link:hover,
  .site-footer__legal-link:focus-visible {
    color: #fff;
  }

  @media (max-width: 780px) {
    .site-footer__bar {
      grid-template-columns: 1fr;
      gap: var(--s6);
      /* Centering each block only reads well when it's competing for space
         inside its own narrow column (the multi-column layout above). Once
         everything stacks into one full-width column, centering each block
         independently gives the brand mark, nav links, and contact block
         three different left edges depending on their own content width.
         justify-items:start sizes each block to its own content (same as
         center does) but anchors all three to the column's left edge
         instead, so they read as one deliberate left-aligned stack. */
      justify-items: start;
      /* Shrinks the whole stacked column to the width of its widest block
         (existing margin:0 auto on this element then centers that shrunk
         column within the footer) — the three blocks still share one left
         edge via justify-items:start above, but the column they share it
         in is no longer pinned to the page's standard left padding. */
      width: max-content;
    }
  }
</style>
