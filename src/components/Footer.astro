---
import { businessName, navLinks, contact, address } from '@/data/site'

interface Props {
  // Removes the footer's top margin so it sits flush against whatever
  // navy/dark surface precedes it (e.g. Home's consultation band, 404's
  // compact content). Ordinary pages keep the default spaced margin.
  flush?: boolean
}

const { flush = false } = Astro.props
const year = new Date().getFullYear()
---

<footer class:list={['site-footer', { 'site-footer--flush': flush }]}>
  <div class="site-footer__bar">
    <div class="site-footer__brand-block">
      <a href="/" class="site-footer__brand" aria-label={`${businessName} — Home`}>
        <img src="/footer-logo-white.webp" alt="" width="230" height="86" class="site-footer__brand-mark" />
      </a>
      <address class="site-footer__address">
        {address.street}, {address.suite}<br />
        {address.city}, {address.state} {address.postalCode}
      </address>
    </div>

    <nav aria-label="Footer">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__contact">
      <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
      <a href={`mailto:${contact.emails.russ}`}>{contact.emails.russ}</a>
      <a href="/contact" class="btn btn-secondary on-navy site-footer__cta">Schedule a Consultation</a>
    </div>
  </div>
  <p class="site-footer__copyright">&copy; {year} Ryan Legal, PC, a Professional Corporation. All Rights Reserved.</p>
</footer>

<style>
  .site-footer {
    background: var(--surface-navy);
    color: var(--surface-navy-fg);
    margin-top: var(--s9);
  }

  .site-footer--flush {
    margin-top: 0;
  }

  .site-footer__bar {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s7) var(--s5);
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: var(--s7);
  }

  .site-footer__brand {
    display: inline-block;
    margin-bottom: var(--s5);
  }

  .site-footer__brand-mark {
    display: block;
    width: 230px;
    max-width: 100%;
    height: auto;
  }

  .site-footer__address {
    font-style: normal;
    color: var(--surface-navy-fg-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .site-footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s3);
  }

  .site-footer nav a {
    color: var(--surface-navy-fg-soft);
    text-decoration: none;
    font-weight: 600;
  }

  .site-footer nav a:hover,
  .site-footer nav a:focus-visible {
    color: #fff;
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
  }

  .site-footer__contact a:not(.btn) {
    color: var(--surface-navy-fg-soft);
    text-decoration: none;
    font-weight: 600;
  }

  .site-footer__contact a:not(.btn):hover,
  .site-footer__contact a:not(.btn):focus-visible {
    color: #fff;
  }

  .site-footer__cta {
    margin-top: var(--s2);
  }

  .site-footer__copyright {
    text-align: center;
    padding: var(--s5) var(--s5) var(--s6);
    margin: 0;
    font-size: 0.8125rem;
    color: var(--surface-navy-fg-soft);
    border-top: 1px solid var(--surface-navy-rule);
  }

  @media (max-width: 780px) {
    .site-footer__bar {
      grid-template-columns: 1fr;
      gap: var(--s6);
    }
  }
</style>
