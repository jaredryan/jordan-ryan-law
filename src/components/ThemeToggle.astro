---
interface Props {
  // "compact": icon-only, used in the wide header bar.
  // "labeled": icon + visible "Appearance" text, used inside the mobile menu.
  variant?: 'compact' | 'labeled'
  class?: string
}

const { variant = 'compact', class: className } = Astro.props
---

<button
  type="button"
  class:list={['theme-toggle', `theme-toggle--${variant}`, className]}
  data-theme-toggle
  aria-pressed="false"
>
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg
      class="theme-toggle__icon-sun"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
      ></path>
    </svg>
    <svg
      class="theme-toggle__icon-moon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
    </svg>
  </span>
  {
    variant === 'labeled' && (
      <span class="theme-toggle__label">
        Appearance: <span data-theme-toggle-label>Light</span>
      </span>
    )
  }
  <span class="sr-only" data-theme-toggle-sr>Switch to dark theme</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    background: transparent;
    border: 1px solid var(--nav-footer-rule);
    color: var(--nav-footer-text);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    background: rgba(255, 255, 255, 0.12);
  }

  .theme-toggle--compact {
    padding: var(--s2);
  }

  .theme-toggle--labeled {
    width: 100%;
    padding: var(--s3) var(--s4);
    justify-content: flex-start;
    font: inherit;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .theme-toggle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle__icon-moon {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle__icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .theme-toggle__icon-moon {
    display: block;
  }
</style>
