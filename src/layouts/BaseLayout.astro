---
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { businessName, defaultDescription, siteUrl } from '@/data/site'
import type { JsonLd } from '@/lib/json-ld'
import '@/styles/global.css'

// Preloaded so the header's brand mark (Libre Baskerville) and nav/CTA text
// (Source Sans 3) are available before first paint — without this, the
// `font-display: swap` fallback (Georgia / system-ui, different metrics)
// renders first and reflows the header when the real font swaps in on every
// full-page navigation. See docs/legacy-content-inventory.md "Known issues".
import libreBaskervilleBoldUrl from '@fontsource/libre-baskerville/files/libre-baskerville-latin-700-normal.woff2?url'
import sourceSans3LatinUrl from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url'

interface Props {
  title: string
  description?: string
  path: string
  keywords?: string[]
  jsonLd?: JsonLd[]
}

const { title, description = defaultDescription, path, keywords, jsonLd = [] } = Astro.props
const canonicalUrl = new URL(path, siteUrl).toString()
const pageTitle = path === '/' ? businessName : `${title} | ${businessName}`
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Blocking, dependency-free: must run before first paint so the page
      // never flashes the wrong theme. Explicit user choice (localStorage)
      // wins; otherwise fall back to the system preference.
      ;(function () {
        try {
          const stored = localStorage.getItem('theme')
          const theme = stored === 'light' || stored === 'dark' ? stored : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
          document.documentElement.setAttribute('data-theme', theme)
        } catch {
          document.documentElement.setAttribute('data-theme', 'light')
        }
      })()
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={libreBaskervilleBoldUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSans3LatinUrl} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/icon.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />
    <meta property="fb:app_id" content="553360804417837" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={businessName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/opengraph-image.png', siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/twitter-image.png', siteUrl).toString()} />

    {jsonLd.map((entry) => <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
