---
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { businessName, defaultDescription, siteUrl } from '@/data/site'
import { buildGraph, type JsonLd } from '@/lib/json-ld'
import '@/styles/global.css'

// Preloaded so the header's brand mark, the page's own H1 (Archivo) and
// nav/CTA text (Inter) are available before first paint — without this, the
// `font-display: swap` fallback (system-ui, different metrics) renders
// first and reflows the header when the real font swaps in on every
// full-page navigation.
import archivoVariableUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url'
import interVariableUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'

interface Props {
  title: string
  description?: string
  path: string
  keywords?: string[]
  jsonLd?: JsonLd[]
  // Renders the footer flush against the preceding section (no top margin)
  // — for pages whose final section is itself a navy/dark surface, so the
  // page ends in one continuous dark block rather than a page-background
  // gap before the footer.
  flushFooter?: boolean
  // For non-indexable pages (currently just 404) — real HTTP 404 status
  // already keeps it out of the index, this is defense in depth.
  noindex?: boolean
}

const {
  title,
  description = defaultDescription,
  path,
  keywords,
  jsonLd = [],
  flushFooter = false,
  noindex = false,
} = Astro.props
const canonicalUrl = new URL(path, siteUrl).toString()
const pageTitle = path === '/' ? businessName : `${title} | ${businessName}`
const graph = jsonLd.length > 0 ? buildGraph(jsonLd) : null
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Blocking, dependency-free: must run before first paint so the page
      // never flashes the wrong theme. Explicit user choice (localStorage)
      // wins; otherwise fall back to the system preference.
      ;(function () {
        try {
          const stored = localStorage.getItem('theme')
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
          document.documentElement.setAttribute('data-theme', theme)
        } catch {
          document.documentElement.setAttribute('data-theme', 'light')
        }
      })()
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={archivoVariableUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interVariableUrl} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={businessName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/opengraph-image.png', siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/twitter-image.png', siteUrl).toString()} />

    {graph && <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer flush={flushFooter} />
    <script is:inline>
      // WebKit's text-autosize/font-boost heuristic (see the
      // text-size-adjust rules in global.css) can re-apply on rotation even
      // though the CSS value never changed. Forcing a style recalc between
      // "none" and "100%" on orientationchange drops any stale boost.
      window.addEventListener('orientationchange', function () {
        const root = document.documentElement
        root.style.setProperty('-webkit-text-size-adjust', 'none')
        void root.offsetHeight
        root.style.setProperty('-webkit-text-size-adjust', '100%')
      })
    </script>
  </body>
</html>
